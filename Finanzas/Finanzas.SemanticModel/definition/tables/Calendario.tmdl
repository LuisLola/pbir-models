	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2023, 1, 1), DATE(2029, 12, 31)),
				    "Año", YEAR([Date]),
				    "AñoTexto", FORMAT([Date], "0000"),
				    "NombreMesAño", FORMAT([Date], "MMM YYYY"),
				    "Semana", WEEKNUM([Date], 2),
				    "NombreSemana", "Semana " & WEEKNUM([Date], 2) & " " & YEAR([Date]),
				    "NombreDía", FORMAT([Date], "DD MMMM YYYY"),
				    "DíaMes", DAY([Date]),
				    "Mes", MONTH([Date]),
				    "DiaSemana", WEEKDAY([Date]),
				     "DiaSemanaTexto", FORMAT([Date], "dddd")
				)

	annotation PBI_Id = 74c0da6b2bab4d23be9822838443e164

