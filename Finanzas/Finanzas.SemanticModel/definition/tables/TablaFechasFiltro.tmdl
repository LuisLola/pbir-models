table TablaFechasFiltro
	lineageTag: 54f3f24f-f017-4a84-b054-34fd1343d051

	measure 'Titulo VENTAS_YTD_LY' = ```
			
			VAR MinY =
			    MINX(
			        ALLSELECTED( TablaFechasFiltro[FechaFiltro] ),
			        YEAR( TablaFechasFiltro[FechaFiltro] )
			    )
			VAR MaxY =
			    MAXX(
			        ALLSELECTED( TablaFechasFiltro[FechaFiltro] ),
			        YEAR( TablaFechasFiltro[FechaFiltro] )
			    )
			VAR HaySeleccion = NOT ISBLANK(MinY) && NOT ISBLANK(MaxY)
			VAR TextoAniosLY =
			    IF(
			        HaySeleccion,
			        IF(MinY = MaxY,
			            FORMAT(MinY - 1, "0"),
			            FORMAT(MinY - 1, "0") & "–" & FORMAT(MaxY - 1, "0")
			        ),
			        FORMAT( YEAR(EDATE(TODAY(), -12)), "0" )   -- por si no hay selección
			    )
			RETURN
			TextoAniosLY
			
			
			```
		lineageTag: f4ca22f7-cb15-46d0-8d99-c8228e06b5d2

