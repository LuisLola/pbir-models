table 'Medidas Finanzas'
	lineageTag: 0a1b2c3d-4e5f-6071-8293-a4b5c6d7e8f9

	measure 'Sum Amount' =
			
			SUM ( LOL_PBIFINANCIALENTRIES[CreditLC] )
			- SUM(LOL_PBIFINANCIALENTRIES[DebitLC])
		displayFolder: 01 Base
		lineageTag: 6eb434e7-2f2e-4726-b278-e3dabe559c82

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Base YTD' =
			
			VAR Val = [Ventas_YTD]
			VAR EntityShowRow =
			    [EntityBrowseDepth] <= LOL_PBIFINANCIALMODEL[EntityRowDepth]
			VAR Result =
			    IF ( EntityShowRow, Val )
			RETURN
			    Result
		displayFolder: 01 Base
		lineageTag: 7e41885a-fd86-4186-a45c-dd080a22ad86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Ventas_YTD =
			
			VAR FechasSeleccionadas =
			    VALUES(TablaFechasFiltro[FechaFiltro])  -- o el nombre exacto de tu tabla de fechas para filtros
			RETURN
			CALCULATE(
			   ( SUM(LOL_PBIFINANCIALENTRIES[CreditLC]) - SUM(LOL_PBIFINANCIALENTRIES[DebitLC]))*AVERAGE(LOL_PBIFINANCIALMODEL[CORRECION]),
			    TREATAS(FechasSeleccionadas, 'Calendario'[Date])
			)
		displayFolder: 01 Base
		lineageTag: 11f4e4f0-8bae-4a43-b0cd-1f22bca4c80c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure VENTAS_YTD_LY = ```
			
			VAR FechasSeleccionadas =
			    VALUES(TablaFechasFiltro[FechaFiltro])  -- Fechas filtradas por el usuario
			 
			RETURN
			CALCULATE(
			( SUM(LOL_PBIFINANCIALENTRIES[CreditLC]) - SUM(LOL_PBIFINANCIALENTRIES[DebitLC]))*AVERAGE(LOL_PBIFINANCIALMODEL[CORRECION]),
			    SAMEPERIODLASTYEAR(FechasSeleccionadas)
			)
			```
		displayFolder: 01 Base
		lineageTag: 1cf1f45e-7841-4693-ad9c-3d18e9a296e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Base YTD_LY' =
			
			VAR Val = [VENTAS_YTD_LY]
			VAR EntityShowRow =
			    [EntityBrowseDepth] <= LOL_PBIFINANCIALMODEL[EntityRowDepth]
			VAR Result =
			    IF ( EntityShowRow, Val )
			RETURN
			    Result
		displayFolder: 01 Base
		lineageTag: 0c9d7bf3-3db7-4253-a7a3-949cc2fbe4b1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Balance Evol.' =
			
			[Total Base YTD] - [Total Base YTD_LY]
		displayFolder: 01 Base
		lineageTag: 09969a74-80f2-4df1-8fea-f0182ac90baf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Balance Porc Evol' =
			
			DIVIDE([Total Base YTD] - [Total Base YTD_LY],[VENTAS_YTD_LY])
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: 01 Base
		lineageTag: f4f31c8d-79d5-40fe-89f7-de7317a657a4

	measure 'PyG_A RESULTADO DE EXPLOTACIÓN' = ```
			
			CALCULATE(
			    SUM(LOL_PBIFINANCIALENTRIES[CreditLC])-SUM(LOL_PBIFINANCIALENTRIES[DebitLC]), 
			    LOL_PBIFINANCIALMODEL[VISUAL_ORDER]<  AVERAGE(LOL_PBIFINANCIALMODEL[PyG_POSICION_A RESULTADO DE EXPLOTACION]),
			    REMOVEFILTERS(LOL_PBIFINANCIALMODEL[ORDER_N3],LOL_PBIFINANCIALMODEL[NIVEL_3],LOL_PBIFINANCIALMODEL[NIVEL_4],LOL_PBIFINANCIALMODEL[Nivel5_Limpio],LOL_PBIFINANCIALMODEL[Nivel6_Limpio]
			))
			```
		displayFolder: 02 P&G
		lineageTag: bf82b4d7-3675-416a-98e4-dc9d1a855568

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PyG Sum_Switch' =
			
			var __groupord = SELECTEDVALUE(LOL_PBIFINANCIALMODEL[VISUAL_ORDER])
			var __switch = SWITCH(__groupord,
			               MIN(LOL_PBIFINANCIALMODEL[PyG_POSICION_A RESULTADO DE EXPLOTACION]), [PyG_A RESULTADO DE EXPLOTACIÓN],
			               MIN(LOL_PBIFINANCIALMODEL[PyG_POSICION_B RESULTADO FINANCIERO]),[PyG_B RESULTADO FINANCIERO],
			               MIN(LOL_PBIFINANCIALMODEL[PyG_POSICION_C RESULTADO ANTES DE IMPUESTOS]), [PyG_C RESULTADO ANTES IMPUESTOS],
			               MIN(LOL_PBIFINANCIALMODEL[PyG_POSICION_D RESULTADO DEL EJERICIO]), [PyG_D RESULTADO EJERCICIO],
			               [Ventas_YTD])
			return
			__switch
		displayFolder: 02 P&G
		lineageTag: 7f41949f-f020-4542-bf1d-b0f53b1fd4ac

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Base YTD PYG' =
			
			VAR Val = [PyG Sum_Switch]
			VAR EntityShowRow =
			    [EntityBrowseDepth] <= LOL_PBIFINANCIALMODEL[EntityRowDepth]
			VAR Result =
			    IF ( EntityShowRow, Val )
			RETURN
			    Result
		formatString: 0
		displayFolder: 02 P&G
		lineageTag: ee317f67-4e9a-4c0d-bd64-bc39e94d3634

	measure 'PyG_B RESULTADO FINANCIERO' = ```
			
			CALCULATE(
			    SUM(LOL_PBIFINANCIALENTRIES[CreditLC])-SUM(LOL_PBIFINANCIALENTRIES[DebitLC]), 
			    AND(LOL_PBIFINANCIALMODEL[VISUAL_ORDER]> AVERAGE(LOL_PBIFINANCIALMODEL[PyG_POSICION_A RESULTADO DE EXPLOTACION]), LOL_PBIFINANCIALMODEL[VISUAL_ORDER]<AVERAGE(LOL_PBIFINANCIALMODEL[PyG_POSICION_B RESULTADO FINANCIERO])),
			    REMOVEFILTERS(LOL_PBIFINANCIALMODEL[ORDER_N3],LOL_PBIFINANCIALMODEL[NIVEL_3],LOL_PBIFINANCIALMODEL[NIVEL_4],LOL_PBIFINANCIALMODEL[Nivel5_Limpio],LOL_PBIFINANCIALMODEL[Nivel6_Limpio]
			))
			```
		displayFolder: 02 P&G
		lineageTag: 4cbeb159-2f5c-4fe3-a852-f7aefd86444e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PyG_C RESULTADO ANTES IMPUESTOS' =
			
			CALCULATE(
			    [PyG_A RESULTADO DE EXPLOTACIÓN]+[PyG_B RESULTADO FINANCIERO],
			    REMOVEFILTERS(LOL_PBIFINANCIALMODEL[ORDER_N3],LOL_PBIFINANCIALMODEL[NIVEL_3],LOL_PBIFINANCIALMODEL[NIVEL_4],LOL_PBIFINANCIALMODEL[Nivel5_Limpio],LOL_PBIFINANCIALMODEL[Nivel6_Limpio]
			))
		displayFolder: 02 P&G
		lineageTag: 1b64e8e2-13a8-4068-bbc2-c9e0d511a62a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'PyG_D RESULTADO EJERCICIO' = ```
			
			CALCULATE(
			    [PyG_C RESULTADO ANTES IMPUESTOS] + SUM(LOL_PBIFINANCIALENTRIES[CreditLC])-SUM(LOL_PBIFINANCIALENTRIES[DebitLC]), 
			    AND(LOL_PBIFINANCIALMODEL[VISUAL_ORDER]> LOL_PBIFINANCIALMODEL[PyG_POSICION_C RESULTADO ANTES DE IMPUESTOS], LOL_PBIFINANCIALMODEL[VISUAL_ORDER]<LOL_PBIFINANCIALMODEL[PyG_POSICION_D RESULTADO DEL EJERICIO]),
			    REMOVEFILTERS(LOL_PBIFINANCIALMODEL[ORDER_N3],LOL_PBIFINANCIALMODEL[NIVEL_3],LOL_PBIFINANCIALMODEL[Nivel5_Limpio],LOL_PBIFINANCIALMODEL[Nivel6_Limpio]
			))
