	measure 'PyG 01.ImporteNeto_LY_complete' = ```
			
			VAR FechasSelec = VALUES ( TablaFechasFiltro[FechaFiltro] )
			VAR AoDesdeSlicer =
			    IF ( NOT ISEMPTY ( FechasSelec ),
			        MAXX ( FechasSelec, YEAR ( TablaFechasFiltro[FechaFiltro] ) )
			    )
			VAR AoDesdeContexto = MIN ( 'Calendario'[Año] )   -- si la matriz tiene Año/Mes de Calendario
			VAR AoBase = COALESCE ( AoDesdeSlicer, AoDesdeContexto, YEAR ( TODAY() ) )
			VAR AoPrevio = AoBase - 1
			RETURN 
			CALCULATE(
			    SUM(LOL_PBIFINANCIALENTRIES[CreditLC])-SUM(LOL_PBIFINANCIALENTRIES[DebitLC]), 
			    LOL_PBIFINANCIALMODEL[ORDER_N3]=5003,
			    LOL_PBIFINANCIALENTRIES[DocumentTypeCode]<> "-3", LOL_PBIFINANCIALENTRIES[DocumentTypeCode]<> "-2",
			     REMOVEFILTERS(LOL_PBIFINANCIALMODEL[ORDER_N3],LOL_PBIFINANCIALMODEL[NIVEL_3],LOL_PBIFINANCIALMODEL[NIVEL_4],LOL_PBIFINANCIALMODEL[Nivel5_Limpio],LOL_PBIFINANCIALMODEL[Nivel6_Limpio]
			),
			
			PREVIOUSYEAR(FechasSelec)
			)
			```
		displayFolder: 02 P&G
		lineageTag: 38ea9f92-1047-42bb-a033-608aec7fc5c9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

