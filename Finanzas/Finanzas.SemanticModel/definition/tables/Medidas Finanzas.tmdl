	measure Media_Saldo_MesFin_Últimos12_PorCuenta = ```
			
			VAR SelectedDateRaw = MAX( TablaFechasFiltro[FechaFiltro] )
			VAR SelectedDate = IF( ISBLANK( SelectedDateRaw ), TODAY(), SelectedDateRaw )
			
			VAR LastMonthEnd = EOMONTH( SelectedDate, -1 )
			VAR FirstMonthEnd = EOMONTH( LastMonthEnd, -11 )
			
			VAR MonthsTable =
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER( ALL( Calendario ),
			                Calendario[Date] >= FirstMonthEnd &&
			                Calendario[Date] <= LastMonthEnd
			            ),
			            "MonthEnd", EOMONTH( Calendario[Date], 0 )
			        )
			    )
			
			VAR SumMonthEndBalances =
			    SUMX(
			        MonthsTable,
			        CALCULATE(
			            -SUM( LOL_PBIFINANCIALENTRIES[CreditLC] ) + SUM( LOL_PBIFINANCIALENTRIES[DebitLC] ),
			            -- filtros por código de cuenta y interlocutor
			            LEFT( LOL_PBIFINANCIALENTRIES[AccountCode], 3 ) = "430"
			                || LEFT( LOL_PBIFINANCIALENTRIES[AccountCode], 3 ) = "431"
			                || LEFT( LOL_PBIFINANCIALENTRIES[AccountCode], 3 ) = "432",
			            LEFT( LOL_PBIFINANCIALENTRIES[BusinessPartnerCode], 1 ) = "M",
			            -- solo movimientos cuya Fecha de vencimiento sea > MonthEnd (el [MonthEnd] viene de MonthsTable)
			            FILTER( ALL( JournalEntryItem ), LOL_PBIFINANCIALENTRIES[DueDate] > [MonthEnd] ),
			            -- acumulado hasta el MonthEnd (para calcular saldo de cierre)
			            FILTER( ALL( Calendario ), Calendario[Date] <= [MonthEnd] )
			        )
			    )
			
			RETURN
			DIVIDE( SumMonthEndBalances, 12 )
			
			```
		displayFolder: 05 Diagnostico
		lineageTag: 5c5ee08c-9fce-4f83-bbd5-26bffb7f50c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Media_Saldo_MesFin_Últimos12_PorCuenta TABLA' =
			
			VAR SelectedDateRaw = MAX( TablaFechasFiltro[FechaFiltro] )
			VAR SelectedDate = IF( ISBLANK( SelectedDateRaw ), TODAY(), SelectedDateRaw )
			
			VAR LastMonthEnd = EOMONTH( SelectedDate, -1 )
			VAR FirstMonthEnd = EOMONTH( LastMonthEnd, -11 )
			
			VAR MonthsTable =
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER( ALL( Calendario ),
			                Calendario[Date] >= FirstMonthEnd &&
			                Calendario[Date] <= LastMonthEnd
			            ),
			            "MonthEnd", EOMONTH( Calendario[Date], 0 )
			        )
			    )
			
			RETURN FirstMonthEnd
		formatString: General Date
		displayFolder: 05 Diagnostico
		lineageTag: 9da96a05-1160-4023-b29a-d9ef7ac25f57

