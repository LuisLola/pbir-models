	partition 'Dimensión Finanzas' = calculated
		mode: import
		source =
				{
				    ("Canal", NAMEOF('JournalEntryItem'[Código 1 de regla de distribución]), 0),
				    ("Tienda", NAMEOF('JournalEntryItem'[Código 2 de regla de distribución]), 1),
				    ("Sucursal", NAMEOF('JournalEntryItem'[Nombre sucursal]), 2),
				    ("Trimestre", NAMEOF('Calendario'[Date].[Trimestre]), 3),
				    ("Mes", NAMEOF('Calendario'[Date].[Mes]), 4),
