		displayFolder: 7 Análisis
		lineageTag: ec8e9ff7-ee01-4727-97f6-a80d7a8858d2

	/// Peso de la devolucion sobre la venta bruta.
	measure '% devuelto sobre venta' = DIVIDE ( [Importe devuelto], [VentaBruta] )
		formatString: 0.0%
		displayFolder: 7 Análisis
