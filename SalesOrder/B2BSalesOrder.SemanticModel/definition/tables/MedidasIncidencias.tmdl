		lineageTag: 87a397c8-8674-4d6b-b4a6-81d615d2e54c

	/// Cuanto de lo que se pide devolver vuelve realmente. Si baja mucho,
	/// o se rechazan solicitudes o se quedan sin tramitar.
	measure '% solicitud que acaba en devolución' = DIVIDE ( [Unidades devueltas], [Unidades solicitadas] )
		formatString: 0.0%
		displayFolder: 7 Análisis
		lineageTag: b0db3ec0-fe72-4214-b0a4-4adbed6b4f9f

	/// Lineas de incidencia de la temporada seleccionada, hasta la fecha de corte.
	measure 'Incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'VentasIncidencias' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 2a1e9796-5c1a-44fa-9148-49648ece8c6e

	/// Las de la temporada anterior, completa.
	measure 'Incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'VentasIncidencias' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 2919e9eb-70a6-4669-b0c8-497142b78a25

	/// Venta bruta afectada por incidencias en la temporada.
	measure 'Importe incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: \€#,##0
		displayFolder: 8 Temporada
		lineageTag: 85015978-ca74-4952-a2f5-b2933cedb7c1

	/// Lo mismo en la temporada anterior.
	measure 'Importe incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt
			        )
			    )
		formatString: \€#,##0
		displayFolder: 8 Temporada
		lineageTag: a984f36a-1a51-4409-ab4c-9e9df774893a

	/// Unidades afectadas en la temporada.
	measure 'Unidades incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[Cantidad] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 8329ddbe-7e68-4b28-bc61-ca87c3b8b056

	/// Unidades afectadas en la anterior.
	measure 'Unidades incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[Cantidad] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: e23f7f0f-e8d0-4f32-9349-b2c731b68882

	/// Diferencia de importe frente a la temporada anterior.
	measure 'Evol incidencias €' = [Importe incidencias temporada] - [Importe incidencias temporada anterior]
		formatString: \€#,##0;-\€#,##0;\€0
		displayFolder: 8 Temporada
		lineageTag: cf098ed7-f604-44bb-89f8-4fe736a775f2

	/// La misma diferencia en porcentaje. En blanco si la anterior es cero,
	/// para no ensenar un infinito.
	measure 'Evol incidencias %' =
			VAR Ant = [Importe incidencias temporada anterior]
			RETURN IF ( NOT ISBLANK ( Ant ) && Ant <> 0, DIVIDE ( [Evol incidencias €], Ant ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 8 Temporada
		lineageTag: 7e87a27d-1a57-48dd-814e-8d13ecf0aee9

	/// Peso de la incidencia sobre la venta de la temporada.
	measure '% incidencia temporada' = DIVIDE ( [Importe incidencias temporada], [VentasTemporadaSeleccionada] )
		formatString: 0.0%
		displayFolder: 8 Temporada
		lineageTag: e33e135a-707b-48f3-bede-a4bf59e7514e

	/// El mismo peso en la temporada anterior, para ver si mejora o empeora.
	measure '% incidencia temporada anterior' = DIVIDE ( [Importe incidencias temporada anterior], [VentasTemporadaAnterior_Total] )
		formatString: 0.0%
		displayFolder: 8 Temporada
		lineageTag: 3c4eab93-1189-4615-899f-f6da25c0267d

	/// Cuantos motivos distintos aparecen. Sirve para ver si el problema esta
	/// concentrado en uno o repartido entre muchos.
	measure 'Motivos con incidencia' = DISTINCTCOUNT ( VentasIncidencias[IncidenciaMotivo] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 11f60787-f16e-4c8c-ac9e-a89f70a52e14

	/// Lineas cuyo codigo de incidencia no esta en el catalogo.
	/// Si esto no es cero, al catalogo le faltan motivos: hoy son los codigos
	/// 20, 16, 28, 15, 18 y 17.
	measure 'Incidencias sin catalogar' =
			CALCULATE ( COUNTROWS ( VentasIncidencias ),
			    CONTAINSSTRING ( VentasIncidencias[IncidenciaMotivo], "Sin catalogar" ) ) + 0
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: cfed6b2a-9a4a-4b72-9fa0-4a16681d5c9e

	/// El pedido ANTES de cancelar: lo que sigue vivo mas lo que se cancelo.
	/// VentasTemporadaSeleccionada deja fuera las lineas de incidencia, asi
	/// que por si sola no sirve de denominador.
	measure 'Pedido bruto temporada' = [VentasTemporadaSeleccionada] + [Importe incidencias temporada]
		formatString: \€#,##0
		displayFolder: 9 Motivos
		lineageTag: b7fe66a0-542c-4360-80b6-ad7b171cc896

	/// Que parte del pedido se cayo. Sobre el bruto, no sobre lo vivo: contra
	/// lo vivo un pedido anulado entero daba 21.685%.
	measure '% cancelado temporada' = DIVIDE ( [Importe incidencias temporada], [Pedido bruto temporada] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 9 Motivos
		lineageTag: 2241694b-85e1-49cc-a9fb-48eec62f8135

	/// Importe cancelado por este motivo. Una medida por motivo porque la
	/// matriz necesita los motivos como COLUMNAS junto a las fijas.
	measure 'Mot. Anulación cliente' =
			CALCULATE ( [Importe incidencias temporada],
			    VentasIncidencias[IncidenciaMotivo] = "ANULACIÓN CLIENTE" )
		formatString: \€#,##0
		displayFolder: 9 Motivos
		lineageTag: 934b0b62-9a50-447d-8d09-b088920d8025

	/// Importe cancelado por este motivo. Una medida por motivo porque la
