	measure VentasTemporadaPasadaSoloInicioIncidencias =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaPas = [TemporadaPasada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaPas ),
			        BLANK (),
			        CALCULATE (
