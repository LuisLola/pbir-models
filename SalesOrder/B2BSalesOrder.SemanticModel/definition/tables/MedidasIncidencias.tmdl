	/// Unidades afectadas en la temporada.
	measure 'Unidades incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[Cantidad] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 8329ddbe-7e68-4b28-bc61-ca87c3b8b056

	/// Unidades afectadas en la anterior.
	measure 'Unidades incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[Cantidad] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: e23f7f0f-e8d0-4f32-9349-b2c731b68882

	/// Diferencia de importe frente a la temporada anterior.
	measure 'Evol incidencias €' = [Importe incidencias temporada] - [Importe incidencias temporada anterior]
		formatString: \€#,##0;-\€#,##0;\€0
		displayFolder: 8 Temporada
		lineageTag: cf098ed7-f604-44bb-89f8-4fe736a775f2

	/// La misma diferencia en porcentaje. En blanco si la anterior es cero,
	/// para no ensenar un infinito.
	measure 'Evol incidencias %' =
			VAR Ant = [Importe incidencias temporada anterior]
			RETURN IF ( NOT ISBLANK ( Ant ) && Ant <> 0, DIVIDE ( [Evol incidencias €], Ant ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 8 Temporada
		lineageTag: 7e87a27d-1a57-48dd-814e-8d13ecf0aee9

	/// Peso de la incidencia sobre la venta de la temporada.
	measure '% incidencia temporada' = DIVIDE ( [Importe incidencias temporada], [VentasTemporadaSeleccionada] )
		formatString: 0.0%
		displayFolder: 8 Temporada
		lineageTag: e33e135a-707b-48f3-bede-a4bf59e7514e

	/// El mismo peso en la temporada anterior, para ver si mejora o empeora.
	measure '% incidencia temporada anterior' = DIVIDE ( [Importe incidencias temporada anterior], [VentasTemporadaAnterior_Total] )
		formatString: 0.0%
		displayFolder: 8 Temporada
		lineageTag: 3c4eab93-1189-4615-899f-f6da25c0267d

