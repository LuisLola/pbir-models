	measure ValidacionIncidenciasAnt_Corte12M = [VentasTemporadaAnteriorIncidencias]
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: fe4bbd39-79fe-4fd7-9782-4b63048ccf3f

	measure ValidacionIncidenciasAnt_DiasEq =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			VAR FechaInicioAnt = [ValidacionFechaInicioTemporadaAnt]
			VAR FechaFinAnt = [ValidacionFechaFinAntDiasEq]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel )
			            || ISBLANK ( TemporadaAnt )
			            || ISBLANK ( FechaInicioAnt )
			            || ISBLANK ( FechaFinAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt,
			            'VentasIncidencias'[FechaDocumento] >= FechaInicioAnt,
			            'VentasIncidencias'[FechaDocumento] <= FechaFinAnt
			        )
			    )
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: f15f2a7f-a331-4c4f-af14-2d643ea782f9

	measure ValidacionDifIncidenciasAnt_DiasEq_vs_Corte12M = [ValidacionIncidenciasAnt_DiasEq] - [ValidacionIncidenciasAnt_Corte12M]
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: 75c5dacd-58be-43fb-aa95-fdda128fc9d3

	measure ValidacionLineasIncidenciasAnt_DiasEq =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			VAR FechaInicioAnt = [ValidacionFechaInicioTemporadaAnt]
			VAR FechaFinAnt = [ValidacionFechaFinAntDiasEq]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel )
			            || ISBLANK ( TemporadaAnt )
			            || ISBLANK ( FechaInicioAnt )
			            || ISBLANK ( FechaFinAnt ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'VentasIncidencias' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt,
			            'VentasIncidencias'[FechaDocumento] >= FechaInicioAnt,
			            'VentasIncidencias'[FechaDocumento] <= FechaFinAnt
			        )
			    )
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: a244e33f-f09c-4939-9f4d-0fbf75632a9d

	/// Lineas registradas como incidencia en el periodo.
	measure 'Líneas de incidencia' = COUNTROWS ( 'VentasIncidencias' )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 9b67f605-803a-416f-a913-5a1583f8a5b9

	/// Cuantos codigos distintos de incidencia aparecen. Sirve para saber si el
	/// problema esta concentrado o repartido.
	measure 'Tipos de incidencia' = DISTINCTCOUNT ( 'VentasIncidencias'[IncidenciaCode] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: eae3e4bf-4c49-405f-b00b-bd51f9c48843

	/// Clientes distintos afectados.
	measure 'Clientes con incidencia' = DISTINCTCOUNT ( 'VentasIncidencias'[CodigoCliente] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 7f92966a-4d3e-40ce-84eb-957b1200d373

	/// Referencias distintas afectadas.
	measure 'Referencias con incidencia' = DISTINCTCOUNT ( 'VentasIncidencias'[CodigoArticulo] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 20393a70-1430-4482-b2ef-68e9957ac663

	/// Agentes distintos con alguna incidencia.
	measure 'Agentes con incidencia' = DISTINCTCOUNT ( 'VentasIncidencias'[CodigoVendedor] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: ad87ade6-abcc-445e-8a52-781c3197a41b

	/// Cuanto pesa de media cada linea de incidencia.
	measure 'Importe medio por incidencia' = DIVIDE ( [VentaBrutaIncidencias], [Líneas de incidencia] )
		formatString: #,0.00
		displayFolder: 7 Análisis
		lineageTag: 047a348f-3fe1-4dbd-abd3-7d203a26cd5f

	/// Tamano medio de la incidencia en unidades.
	measure 'Unidades por incidencia' = DIVIDE ( [CantidadIncidencias], [Líneas de incidencia] )
		formatString: #,0.0
		displayFolder: 7 Análisis
		lineageTag: 50d41a3a-8e78-43a6-b992-c27f9b2f064a

	/// Peso de las incidencias sobre la venta bruta del mismo contexto.
	measure '% incidencia sobre venta' = DIVIDE ( [VentaBrutaIncidencias], [VentaBruta] )
		formatString: 0.0%
		displayFolder: 7 Análisis
		lineageTag: 85541641-8116-4b0f-b25c-e9ee74210ff1

	/// Documentos de solicitud de devolucion.
	measure 'Solicitudes de devolución' = DISTINCTCOUNT ( LOL_PBIRETURNREQUESTS[DocNum] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 9eab8250-d172-4924-8a83-036705573aac

	/// Lineas dentro de esas solicitudes.
	measure 'Líneas solicitadas' = COUNTROWS ( LOL_PBIRETURNREQUESTS )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 87a3e296-d7f7-431e-a4ed-841c7bdf9821

	/// Unidades que el cliente pide devolver.
	measure 'Unidades solicitadas' = SUM ( LOL_PBIRETURNREQUESTS[Qty] )
		formatString: #,0
		displayFolder: 7 Análisis
		lineageTag: 5fe7c418-455b-4100-a98c-2030406b8935

	/// Devoluciones que se han llegado a hacer.
	measure Devoluciones = DISTINCTCOUNT ( LOL_PBIRETURNSALES[DocNum] )
