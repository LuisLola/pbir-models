		lineageTag: 1411be7e-3733-4ed4-9cfc-90d6a389f81a

	/// Importe neto abonado al cliente.
	measure 'Importe abonado' = SUM ( LOL_PBICREDITNOTESSALES[NetAmt_EUR] )
		formatString: #,0.00
