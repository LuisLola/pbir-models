	measure LineasSalesOrderExcluidasPorIncidencia =
			CALCULATE (
			    COUNTROWS ( 'LOL_PBIB2BSALESORDER' ),
			    'LOL_PBIB2BSALESORDER'[IsIncidence] = "Y"
			)
		formatString: #,##0
		displayFolder: Control
		lineageTag: 4c9747d5-3d44-4ef3-89a1-b78f91962637

	measure VentasTemporadaSeleccionadaIncidencias =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        0,
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: c447b4fe-37e6-4a3c-9ef2-8e97b02ddc41

	measure VentasTemporadaAnteriorIncidencias =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			VAR FechaCorteAnt = EDATE ( FechaCorte, -12 )
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorteAnt
			        )
			    )
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: f0b60d4e-41d8-423b-9810-477f4010b4d8

	measure VentasTemporadaAnteriorSoloInicioIncidencias =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt,
			            'VentasIncidencias'[PedidoReposicionLinea] <> "Y"
			        )
			    )
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: f078b7c4-21b7-4cb7-a911-06c0c957337f

	measure VentasTemporadaAnteriorTotalIncidencias =
