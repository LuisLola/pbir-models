		lineageTag: 87a397c8-8674-4d6b-b4a6-81d615d2e54c

	/// Cuanto de lo que se pide devolver vuelve realmente. Si baja mucho,
	/// o se rechazan solicitudes o se quedan sin tramitar.
	measure '% solicitud que acaba en devolución' = DIVIDE ( [Unidades devueltas], [Unidades solicitadas] )
		formatString: 0.0%
		displayFolder: 7 Análisis
		lineageTag: b0db3ec0-fe72-4214-b0a4-4adbed6b4f9f

	/// Lineas de incidencia de la temporada seleccionada, hasta la fecha de corte.
	measure 'Incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'VentasIncidencias' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 2a1e9796-5c1a-44fa-9148-49648ece8c6e

	/// Las de la temporada anterior, completa.
	measure 'Incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'VentasIncidencias' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaAnt
			        )
			    )
		formatString: #,0
		displayFolder: 8 Temporada
		lineageTag: 2919e9eb-70a6-4669-b0c8-497142b78a25

	/// Venta bruta afectada por incidencias en la temporada.
	measure 'Importe incidencias temporada' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'VentasIncidencias'[FechaDocumento] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'VentasIncidencias'[TemporadaLinea] = TemporadaSel,
			            'VentasIncidencias'[FechaDocumento] <= FechaCorte
			        )
			    )
		formatString: \€#,##0
		displayFolder: 8 Temporada
		lineageTag: 85015978-ca74-4952-a2f5-b2933cedb7c1

	/// Lo mismo en la temporada anterior.
	measure 'Importe incidencias temporada anterior' =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ) || ISBLANK ( TemporadaAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'VentasIncidencias'[VentaBrutaML] ),
			            REMOVEFILTERS ( 'Calendario' ),
