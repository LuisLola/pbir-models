	/// Peso del Total Look sobre la cartera pendiente.
	measure '% Cartera Total Look' =
			
			DIVIDE ( [Cartera Total Look], [Cartera pendiente] )
		formatString: 0\ %;-0\ %;0\ %
		displayFolder: Total Look
		lineageTag: b6946212-ed6f-48be-a63c-f31dbc788131

	/// Cartera pendiente de entregar de los articulos que forman parte de un Total Look.
	measure 'Cartera Total Look' =
			
			CALCULATE (
			    [Cartera pendiente],
			    LOL_PBIMODELITEM[Total Look] = "Total Look"
			)
		formatString: #,0\ "€";-#,0\ "€";#,0\ "€"
		displayFolder: Total Look
		lineageTag: 339b3988-9902-4f57-ab7d-44e54ff994e6

	/// Lineas de pedido cuyo articulo pertenece a un Total Look.
	measure 'Lineas Total Look' =
			
			CALCULATE (
			    COUNTROWS ( LOL_PBIB2BSALESORDER ),
			    LOL_PBIMODELITEM[Total Look] = "Total Look"
			)
		formatString: #,0
		displayFolder: Total Look
		lineageTag: e731489f-6d59-45c7-b42c-6326d1b8b2fd

	/// Dia tope del segmentador Hasta Fecha Disponibilidad Stock. Si nadie lo ha tocado, hoy.
	measure 'Fecha disponibilidad seleccionada' =
			
			VAR Tope =
			    IF (
			        ISFILTERED ( LOL_PLANMATERIAL[Fecha disponibilidad (línea del articulo)] ),
			        CALCULATE (
			            MAX ( LOL_PLANMATERIAL[Fecha disponibilidad (línea del articulo)] ),
			            ALLSELECTED ( LOL_PLANMATERIAL[Fecha disponibilidad (línea del articulo)] )
			        )
			    )
			RETURN
			COALESCE ( Tope, TODAY () )
		formatString: Short Date
		displayFolder: Cierre del mes
		lineageTag: 44cd57e9-0b41-4f4f-826d-a3e7bfe883ff

	/// Ultimo dia del mes que contiene la fecha de disponibilidad elegida.
	measure 'Fin mes de cierre' =
			
			EOMONTH ( [Fecha disponibilidad seleccionada], 0 )
		formatString: Short Date
		displayFolder: Cierre del mes
		lineageTag: 2cde1294-8a7f-4996-ad76-5aebb606c9a2

	/// Primer dia del mes que contiene la fecha de disponibilidad elegida.
	measure 'Inicio mes de cierre' =
			
			EOMONTH ( [Fecha disponibilidad seleccionada], -1 ) + 1
		formatString: Short Date
		displayFolder: Cierre del mes
		lineageTag: 02ab5c42-b8c7-45b5-b464-a846c6867d0d

	/// Etiqueta del mes que se esta calculando. Ponla en una tarjeta: al quitar el segmentador de mes es la unica pista visual de que mes se muestra.
	measure 'Mes de cierre' =
			
			FORMAT ( [Fecha disponibilidad seleccionada], "mmm yyyy" )
		displayFolder: Cierre del mes
		lineageTag: 7c4418ad-c214-4d1f-b3f4-7a957545a8e4

	/// Cuantos codigos de Total Look distintos hay en el contexto actual.
	measure 'Looks distintos' =
			
			CALCULATE (
			    DISTINCTCOUNT ( LOL_PBIMODELITEM[Código Total Look] ),
			    LOL_PBIMODELITEM[Total Look] = "Total Look"
			)
		formatString: #,0
		displayFolder: Total Look
		lineageTag: 2527ba56-cca9-408a-aba2-1d76b7a8d69f

	/// Referencias de modelo que no pertenecen a ningun Total Look.
	measure 'Referencias sueltas' =
			
			CALCULATE (
			    DISTINCTCOUNT ( LOL_PBIMODELITEM[Referencia_modelo] ),
			    LOL_PBIMODELITEM[Total Look] = "Prenda suelta"
			)
		formatString: #,0
		displayFolder: Total Look
		lineageTag: 1aa69538-b987-4b0b-a9a7-2f31c457c05b

	/// Referencias de modelo agrupadas bajo algun Total Look. Es el criterio en si: el campo agrupa referencias.
	measure 'Referencias Total Look' =
			
			CALCULATE (
			    DISTINCTCOUNT ( LOL_PBIMODELITEM[Referencia_modelo] ),
			    LOL_PBIMODELITEM[Total Look] = "Total Look"
			)
		formatString: #,0
		displayFolder: Total Look
		lineageTag: a51b3872-8d03-467b-a9de-239ac6492fa2

	/// Dice si se estan adelantando entregas y, si sale cero, por que. En blanco si la fecha de servicio es la de hoy.
	measure 'Aviso adelanto entrega' =
			
			VAR Servicio = [Fecha servicio seleccionada]
			VAR FinCierre = [Fin mes de cierre]
			VAR Importe = [Adelanto entrega]
			RETURN
			IF (
			    Servicio = TODAY (),
			    BLANK (),
			    SWITCH (
			        TRUE (),
			        Servicio <= FinCierre,
			            "Sin adelanto: corte " & FORMAT ( FinCierre, "dd/mm/yyyy" ),
			        Importe > 0,
			            "Adelanto de entregas: " & FORMAT ( Importe, "#,0" ) & " €",
			        "Sin adelanto de entregas"
			    )
			)
		displayFolder: Cierre del mes
		lineageTag: c2017cbc-f11b-410b-887b-a1685d0694c2

	/// Avisa de si el mes de cierre que se esta calculando es el mes en curso o no. En blanco si la fecha de servicio es la de hoy.
	measure 'Aviso mes de cierre' =
			
			VAR Servicio = [Fecha servicio seleccionada]
			VAR FinCierre = [Fin mes de cierre]
			VAR FinHoy = EOMONTH ( TODAY (), 0 )
			RETURN
			IF (
			    Servicio = TODAY (),
			    BLANK (),
			    IF (
			        FinCierre = FinHoy,
			        "Mes en curso: " & [Mes de cierre],
			        "Fuera del mes en curso: " & [Mes de cierre]
			    )
			)
		displayFolder: Cierre del mes
		lineageTag: 74e5bf48-bfe1-4481-9d74-146c7eaadac0

	/// Dia tope del segmentador Hasta Fecha Fin pedido venta. Si nadie lo ha tocado, hoy.
	measure 'Fecha servicio seleccionada' =
			
			VAR Tope =
			    IF (
			        ISFILTERED ( LOL_PLANMATERIAL[Fecha Fin pedido venta] ),
			        CALCULATE (
			            MAX ( LOL_PLANMATERIAL[Fecha Fin pedido venta] ),
			            ALLSELECTED ( LOL_PLANMATERIAL[Fecha Fin pedido venta] )
			        )
			    )
			RETURN
			COALESCE ( Tope, TODAY () )
		formatString: Short Date
		displayFolder: Cierre del mes
		lineageTag: 1062be4c-2648-4f56-8958-3d41d56ba8a2

	/// 1 cuando la fecha de servicio no es la de hoy. Ponla en el panel de filtros de las tarjetas de aviso (es 1) para que solo aparezcan al salirse del dia en curso.
	measure 'Mostrar avisos' =
			
			INT ( [Fecha servicio seleccionada] <> TODAY () )
		formatString: 0
		displayFolder: Cierre del mes
		lineageTag: 110be1a5-64fb-4953-b9ad-cf3d73047dfa

	column Value
		lineageTag: 2848c4c9-fd79-45ec-8f68-88eccb9c7834
		isNameInferred
		sourceColumn: [Value]

	partition MedidasCartera = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_ResultType = Table

