	measure 'Filtros activos' = ```
			
			INT ( ISFILTERED ( LOL_PBIAGENTES[Agente_Cajero] ) ) +
			INT ( ISFILTERED ( MesFacturacion[Mes] ) ) +
			INT ( ISFILTERED ( LOL_PBISEASON[Code] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[P&H] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[TotalLook] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[Autorizado] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[Bloqueado] ) ) +
			INT ( ISFILTERED ( LOL_PBICLIENTES[RazonSocial] ) ) +
			INT ( ISFILTERED ( LOL_PBIMODELITEM[Categoria] ) ) +
			INT ( ISFILTERED ( LOL_PBIMODELITEM[GrupodeArt] ) ) +
			INT ( ISFILTERED ( LOL_PBIMODELITEM[Descripcion_familia_agregada] ) ) +
			INT ( ISFILTERED ( LOL_PBIMODELITEM[Subfamilia] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[Fecha Fin pedido venta] ) ) +
			INT ( ISFILTERED ( LOL_PLANMATERIAL[Fecha disponibilidad (línea del articulo)] ) )
			
			```
