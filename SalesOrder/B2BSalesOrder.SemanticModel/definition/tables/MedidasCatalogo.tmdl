						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIAGENTES[Agente_Cajero], LOL_PBICLIENTES[Pais], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIAGENTES[Agente_Cajero] & "", "@g2", LOL_PBICLIENTES[Pais] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 8 && _ix2 = 7 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIAGENTES[Agente_Cajero], LOL_PBISEASON[Name], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIAGENTES[Agente_Cajero] & "", "@g2", LOL_PBISEASON[Name] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 8 && _ix2 = 9 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIAGENTES[Agente_Cajero], LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIAGENTES[Agente_Cajero] & "", "@g2", LOL_PBIB2BSALESORDER[DocNum] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 8 && _ix2 = 10 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIMODELITEM[Categoria], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIMODELITEM[Categoria] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 0 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIMODELITEM[Descripcion_familia_agregada], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIMODELITEM[Descripcion_familia_agregada] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 1 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIMODELITEM[Nombre_familia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIMODELITEM[Nombre_familia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 2 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIMODELITEM[Subfamilia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIMODELITEM[Subfamilia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 3 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIMODELITEM[GrupodeArt], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIMODELITEM[GrupodeArt] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 4 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBICLIENTES[RazonSocial], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBICLIENTES[RazonSocial] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 5 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBICLIENTES[GroupName], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBICLIENTES[GroupName] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 6 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBICLIENTES[Pais], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBICLIENTES[Pais] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 7 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIAGENTES[Agente_Cajero], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIAGENTES[Agente_Cajero] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 8 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBISEASON[Name], LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBISEASON[Name] & "", "@g2", LOL_PBIB2BSALESORDER[DocNum] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _ix2 = 10 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Categoria], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIMODELITEM[Categoria] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 0 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Descripcion_familia_agregada], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIMODELITEM[Descripcion_familia_agregada] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 1 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Nombre_familia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIMODELITEM[Nombre_familia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 2 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[Subfamilia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIMODELITEM[Subfamilia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 3 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIMODELITEM[GrupodeArt], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIMODELITEM[GrupodeArt] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 4 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBICLIENTES[RazonSocial], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBICLIENTES[RazonSocial] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 5 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBICLIENTES[GroupName], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBICLIENTES[GroupName] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 6 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBICLIENTES[Pais], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBICLIENTES[Pais] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 7 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBIAGENTES[Agente_Cajero], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBIAGENTES[Agente_Cajero] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 8 ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBIB2BSALESORDER, LOL_PBIB2BSALESORDER[DocNum], LOL_PBISEASON[Name], LOL_PBIMODELITEM[Modelo-Color] ), "ven", CALCULATE( SUM( LOL_PBIB2BSALESORDER[ImporteBruto] ) ), "u", CALCULATE( SUMX( LOL_PBIB2BSALESORDER, IFERROR( VALUE( LOL_PBIB2BSALESORDER[Qty] ), 0 ) ) ) ), "@g", LOL_PBIB2BSALESORDER[DocNum] & "", "@g2", LOL_PBISEASON[Name] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 10 && _ix2 = 9 )
						        ),
						        REMOVEFILTERS( 'Calendario' ),
						        REMOVEFILTERS( LOL_PBIB2BSALESORDER[DocDate] ),
						        LOL_PBIB2BSALESORDER[Canceled] <> "Y",
						        LOL_PBIB2BSALESORDER[IsIncidence] <> "Y",
						        LOL_PBIB2BSALESORDER[DocDate] <= _FechaCorte,
						        LOL_PBIB2BSALESORDER[Season] = _temp || ISBLANK( _temp )
						    )
						VAR _pairs =
						    ADDCOLUMNS( _pairs0, "@v",
						        SWITCH( _ord,
						            "Unidades", [@u],
						            "PVP",
						                VAR _mm = [@m]
						                VAR _t = CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )
						                RETURN COALESCE( IFERROR( VALUE( _t ), IFERROR( VALUE( SUBSTITUTE( SUBSTITUTE( _t, ".", "" ), ",", "." ) ), 0 ) ), 0 ),
						            [@ven]
						        )
						    )
						/* primera de las dos unicas pasadas sobre la tabla cara */
						VAR _celdas =
						    GROUPBY( _pairs, [@g], [@g2],
						        "@st", SUMX( CURRENTGROUP(), [@ven] ),
						        "@mx", MAXX( CURRENTGROUP(), [@v] ),
						        "@nr", COUNTX( CURRENTGROUP(), 1 )
						    )
						VAR _groups = GROUPBY( _celdas, [@g], "@gt", SUMX( CURRENTGROUP(), [@st] ), "@nref", SUMX( CURRENTGROUP(), [@nr] ) )
						VAR _gTop = TOPN( 12, FILTER( _groups, [@gt] > 0 ), [@gt], DESC )
						VAR _gKeys = SELECTCOLUMNS( _gTop, "@g", [@g] )
						VAR _cSel = FILTER( _celdas, [@st] > 0 && [@g] IN _gKeys )
						VAR _cTop =
						    FILTER( _cSel,
						        VAR g = [@g]  VAR s = [@st]
						        RETURN COUNTROWS( FILTER( _cSel, [@g] = g && [@st] > s ) ) < 8
						    )
						VAR _cKeys = SELECTCOLUMNS( _cTop, "@g", [@g], "@g2", [@g2] )
						/* segunda pasada: solo el detalle de las celdas que se van a pintar */
						VAR _detG =
						    GROUPBY(
						        FILTER( _pairs, [@ven] > 0 && ( [@g], [@g2] ) IN _cKeys ),
						        [@g], [@g2], [@m],
						        "@ven2", SUMX( CURRENTGROUP(), [@ven] ),
						        "@u2", SUMX( CURRENTGROUP(), [@u] ),
						        "@v2", MAXX( CURRENTGROUP(), [@v] )
						    )
						/* ficha del modelo una sola vez; [@m] tiene que pasar por variable */
						VAR _info =
						    ADDCOLUMNS(
						        DISTINCT( SELECTCOLUMNS( _detG, "@m", [@m] ) ),
						        "@img", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[URL_imagen_producto] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@nom", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Descripcion_modelo] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@cat", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Categoria] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@marca", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[GrupodeArt] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@pvpx", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )
						    )
						VAR _det = NATURALLEFTOUTERJOIN( _detG, _info )
						VAR _body =
						    CONCATENATEX(
						        _gTop,
						        VAR _gv = [@g]
						        VAR _gt = [@gt]
						        VAR _nref = [@nref]
						        VAR _bloques =
						            CONCATENATEX(
						                FILTER( _cTop, [@g] = _gv ),
						                VAR _sv = [@g2]
						                VAR _st = [@st]
						                VAR _max = [@mx]
						                VAR _inCell = FILTER( _det, [@g] = _gv && [@g2] = _sv )
						                VAR _cards =
						                    CONCATENATEX(
						                        TOPN( _TopN, _inCell, [@v2], DESC ),
						                        VAR _m = [@m]
						                        VAR _ven = [@ven2]
						                        VAR _u = [@u2]
						                        VAR _v = [@v2]
						                        VAR _r = RANKX( _inCell, [@v2],, DESC, DENSE )
						                        VAR _medal = SWITCH( _r, 1, "#DFA0C9", 2, "#000000", 3, "#8A8A8A", "#C9C9C9" )
						                        VAR _marca = [@marca]
						                        VAR _bu = UPPER( COALESCE( _marca, "" ) )
						                        VAR _bcol = SWITCH( TRUE(), _bu = "MAITE", "#DFA0C9", _bu = "LOLA", "#000000", "#8A8A8A" )
						                        VAR _nm = [@nom]
						                        VAR _cat = [@cat]
						                        VAR _pvp = [@pvpx]
						                        VAR _sil = IF( _cat = "Accesorio", _silA, _silP )
						                        VAR _img = [@img]
						                        VAR _imgT = IF( NOT ISBLANK( _img ) && LEN( _img ) > 5, "<img src='" & _img & "' onerror=""this.style.display='none'"" />", "" )
						                        VAR _bp = INT( DIVIDE( _v, _max ) * 100 )
			
						                RETURN
						                    "<div class='card'>" &
						                    "<div class='rank' style='background:" & _medal & "'>" & _r & "</div>" &
						                    "<div class='brand' style='background:" & _bcol & "'>" & COALESCE( _marca, "" ) & "</div>" &
						                    "<div class='ib'>" & IF( LEN( _imgT ) > 0, _imgT, _sil ) & "</div>" &
						                    "<div class='sku'>" & _m & "</div>" &
						                    "<div class='nm'>" & COALESCE( _nm, "" ) & "</div>" &
						                    "<div class='mt'>" & COALESCE( _cat, "" ) & IF( NOT ISBLANK( _pvp ), " · PVP " & _pvp, "" ) & "</div>" &
						                    "<div class='sl'>" & FORMAT( _ven, "#,##0", "es-ES" ) & " €</div>" &
						                    "<div class='bt'><div class='bf' style='width:" & _bp & "%'></div></div>" &
						                    "<div class='kp'>" & FORMAT( _u, "#,##0", "es-ES" ) & " uds</div>" &
						                    "</div>",
			                        "", [@v2], DESC
						                    )
						                RETURN
						                    IF( LEN( _sv ) > 0,
						                        "<details class='sb' open><summary class='sub'><span class='st'>" & _sv & "</span><span class='se'>" & FORMAT( _st, "#,##0", "es-ES" ) & " €</span></summary><div class='grid'>" & _cards & "</div></details>",
						                        "<div class='grid'>" & _cards & "</div>" ),
						                "", [@st], DESC
						            )
						        RETURN
						            "<details class='sec' open><summary class='sh'><div><span class='t'>" & _gv & "</span><span class='n'>" & _nref & " ref.</span></div><span class='e'>" & FORMAT( _gt, "#,##0", "es-ES" ) & " €</span></summary>" & _bloques & "</details>",
						        "", [@gt], DESC
						    )
						RETURN
						    _Css & "<div class='wrap'>" & IF( LEN( _body ) = 0, "<div class='empty'>Sin ventas para los filtros actuales.</div>", _body ) & "</div>"
		displayFolder: Catálogo B2B
		lineageTag: b1a2c3d4-0402-4402-8402-000000000402

	column Value
		lineageTag: b1a2c3d4-0403-4403-8403-000000000403
		isNameInferred
		sourceColumn: [Value]

	partition MedidasCatalogo = calculated
		mode: import
		source = {BLANK()}

	annotation PBI_ResultType = Table

