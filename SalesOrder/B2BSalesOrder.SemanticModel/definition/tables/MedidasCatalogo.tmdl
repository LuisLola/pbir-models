table MedidasCatalogo
	lineageTag: b1a2c3d4-0400-4400-8400-000000000400

	measure 'Catálogo Top N' = SELECTEDVALUE( ParamTopN[Top N], 10 )
		formatString: 0
		displayFolder: Catálogo B2B
		lineageTag: b1a2c3d4-0401-4401-8401-000000000401

	/// Catálogo visual de productos B2B (foto, ranking con medallas, badge de marca). Se agrupa por la dimensión elegida en DimensionB2B, se ordena por OrdenSelector y muestra Top N (ParamTopN) por grupo. Ventas = ImporteBruto (excluye anulados/incidencias, hasta fecha de corte, respeta la temporada seleccionada). Devuelve HTML: usar en el visual "HTML Content".
	measure 'HTML Catálogo B2B' =
						VAR _TopN = [Catálogo Top N]
						VAR _ix = COALESCE( SELECTEDVALUE( DimensionB2B1[DimensionB2B1 Orden] ), SELECTEDVALUE( DimensionB2B[Orden] ), 0 )
						VAR _ord = SELECTEDVALUE( OrdenSelector[Orden], "Ventas (€)" )
						VAR _FechaCorte = [FechaLimiteSeleccionada]
						VAR _temp = [TemporadaSeleccionada]
						VAR _Css =
						    "<style>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');" & ".wrap{font-family:Montserrat,'Segoe UI',Arial,sans-serif;background:transparent;color:#000000;padding:8px}" & ".sec{margin:0 0 12px}" & ".sh{display:flex;align-items:center;justify-content:space-between;border-bottom:none;padding-bottom:3px;margin:0 0 9px;background:#DFA0C9;border-radius:9px;padding:7px 12px}" & ".sh .t{font-size:15px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.8px}" & ".sh .n{font-size:9px;color:#000000;margin-left:7px;font-weight:600}" & ".sh .e{font-size:16px;font-weight:800;color:#000000;background:#FFFFFF;padding:4px 14px;border-radius:10px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.16)}" & ".sub{display:flex;align-items:center;justify-content:space-between;margin:10px 0 6px;border-left:4px solid #DFA0C9;padding-left:6px;background:#F2F2F2;border-radius:0 8px 8px 0;padding:5px 10px}" & ".sub .st{font-size:12px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.3px}" & ".sub .se{font-size:13px;font-weight:800;color:#000000;background:#FFFFFF;padding:3px 11px;border-radius:9px;white-space:nowrap;box-shadow:0 1px 2px rgba(0,0,0,.10)}" & "details.sec>summary,details.sb>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:41px;z-index:6;background:#F2F2F2}" & "details.sec>summary::-webkit-details-marker,details.sb>summary::-webkit-details-marker{display:none}" & "details.sec>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:0;z-index:7;background:#DFA0C9}" & "details.sb>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:41px;z-index:6;background:#F2F2F2}" & "details.sec>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;min-width:20px;margin-right:9px;border-radius:6px;background:#000000;color:#FFFFFF;font-size:10px;font-weight:800}" & "details.sec:not([open])>summary::before{content:'\25B6';background:#000000;color:#FFFFFF}" & "details.sec>summary:hover::before{outline:2px solid #000000;outline-offset:1px}" & "details.sb>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;min-width:15px;margin-right:7px;border-radius:4px;background:#808080;color:#FFFFFF;font-size:8px;font-weight:800}" & "details.sb:not([open])>summary::before{content:'\25B6';background:#808080;color:#FFFFFF}" & "details.sb>summary:hover::before{outline:2px solid #808080;outline-offset:1px}" & ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:7px}" & ".card{position:relative;background:#fff;border:1px solid #E6E6E6;border-radius:9px;padding:6px;box-shadow:0 1px 2px rgba(0,0,0,.08)}" & ".rank{position:absolute;top:8px;left:8px;width:18px;height:18px;border-radius:5px;color:#fff;font-weight:800;font-size:9px;display:flex;align-items:center;justify-content:center;z-index:2}" & ".brand{position:absolute;top:8px;right:8px;color:#fff;font-size:7px;font-weight:700;padding:1px 4px;border-radius:7px;z-index:2}" & ".ib{position:relative;aspect-ratio:3/4;border-radius:6px;border:1px solid #E6E6E6;background:#F2F2F2;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:4px}" & ".ib img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}" & ".sil{width:28px;height:28px}" & ".cap{position:absolute;bottom:5px;left:0;right:0;text-align:center;font-size:7px;letter-spacing:.8px;color:#808080;text-transform:uppercase}" & ".sku{font-family:Consolas,monospace;font-size:8px;color:#808080}" & ".nm{font-size:11px;font-weight:700;line-height:1.15;margin:2px 0 1px}" & ".al{font-size:8px;color:#808080;font-style:italic;margin:0 0 2px;min-height:10px}" & ".mt{font-size:9px;color:#808080;margin-bottom:5px}" & ".sl{font-size:16px;font-weight:800;color:#000000}" & ".bt{height:4px;background:#E6E6E6;border-radius:3px