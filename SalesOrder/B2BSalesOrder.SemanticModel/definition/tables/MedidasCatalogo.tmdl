						VAR _silA = "<svg class='sil' viewBox='0 0 48 48' fill='none' stroke='#D9C2D0' stroke-width='2' stroke-linejoin='round'><path d='M14 19 L34 19 L36 41 L12 41 Z'/><path d='M20 19 Q20 11 24 11 Q28 11 28 19'/></svg>"
