table MedidasCatalogo
	lineageTag: b1a2c3d4-0400-4400-8400-000000000400

	measure 'Catálogo Top N' = SELECTEDVALUE( ParamTopN[Top N], 10 )
		formatString: 0
		displayFolder: Catálogo B2B
		lineageTag: b1a2c3d4-0401-4401-8401-000000000401

	/// Catálogo visual de productos B2B (foto, ranking con medallas, badge de marca). Se agrupa por la dimensión elegida en DimensionB2B, se ordena por OrdenSelector y muestra Top N (ParamTopN) por grupo. Ventas = ImporteBruto (excluye anulados/incidencias, hasta fecha de corte, respeta la temporada seleccionada). Devuelve HTML: usar en el visual "HTML Content".
	measure 'HTML Catálogo B2B' =
						VAR _TopN = [Catálogo Top N]
						VAR _ix = COALESCE( SELECTEDVALUE( DimensionB2B1[DimensionB2B1 Orden] ), SELECTEDVALUE( DimensionB2B[Orden] ), 0 )
						VAR _ord = SELECTEDVALUE( OrdenSelector[Orden], "Ventas (€)" )
						VAR _FechaCorte = [FechaLimiteSeleccionada]
						VAR _temp = [TemporadaSeleccionada]
						VAR _Css =
						    "<style>@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');" &
						    ".wrap{font-family:Montserrat,'Segoe UI',Arial,sans-serif;background:transparent;color:#000000;padding:8px}" &
						    ".sec{margin:0 0 16px}" &
						    ".sh{display:flex;align-items:center;justify-content:space-between;border-bottom:2px solid #DFA0C9;padding-bottom:4px;margin:4px 0 9px}" &
						    ".sh .t{font-size:13px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.6px}" &
						    ".sh .e{font-size:15px;font-weight:800;color:#000000;background:#DFA0C9;padding:2px 11px;border-radius:9px;white-space:nowrap}" &
						    ".sub{display:flex;align-items:center;justify-content:space-between;margin:9px 0 5px;border-left:3px solid #DFA0C9;padding-left:7px}" &
						    ".sub .st{font-size:11px;font-weight:700;color:#000000;text-transform:uppercase;letter-spacing:.4px}" &
						    ".sub .se{font-size:12px;font-weight:800;color:#000000;background:#EFEFEF;padding:1px 9px;border-radius:7px;white-space:nowrap}" &
						    "details.sec>summary,details.sb>summary{cursor:pointer;list-style:none;user-select:none}" &
						    "details.sec>summary::-webkit-details-marker,details.sb>summary::-webkit-details-marker{display:none}" &
						    "details.sec>summary{position:sticky;top:0;z-index:6;background:#FFFFFF;padding-top:4px}" &
						    "details.sb>summary{position:sticky;top:34px;z-index:5;background:#FFFFFF}" &
						    "details.sec>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;min-width:20px;margin-right:9px;border-radius:6px;background:#DFA0C9;color:#000000;font-size:10px;font-weight:800}" &
						    "details.sec:not([open])>summary::before{content:'\25B6';background:#000000;color:#FFFFFF}" &
						    "details.sb>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;min-width:15px;margin-right:7px;border-radius:4px;background:#EFEFEF;color:#000000;font-size:8px;font-weight:800}" &
						    "details.sb:not([open])>summary::before{content:'\25B6';background:#8A8A8A;color:#FFFFFF}" &
						    ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(135px,1fr));gap:8px}" &
						    ".card{position:relative;background:#fff;border:1px solid #EAEAEA;border-radius:11px;padding:7px;box-shadow:0 1px 2px rgba(0,0,0,.08)}" &
						    ".rank{position:absolute;top:11px;left:11px;width:21px;height:21px;border-radius:6px;color:#fff;font-weight:800;font-size:10px;display:flex;align-items:center;justify-content:center;z-index:2}" &
						    ".brand{position:absolute;top:11px;right:11px;color:#fff;font-size:8px;font-weight:700;padding:2px 6px;border-radius:9px;z-index:2}" &
						    ".ib{position:relative;aspect-ratio:3/4;border-radius:8px;border:1px solid #F0E6EC;background:#F9ECF3;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:6px}" &
						    ".ib img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}" &
						    ".sil{width:38px;height:38px}" &
						    ".sku{font-family:Consolas,monospace;font-size:10px;color:#8A8A8A}" &
						    ".nm{font-size:11px;font-weight:700;line-height:1.15;margin:2px 0 1px}" &
						    ".mt{font-size:9px;color:#8A8A8A;margin-bottom:5px}" &
						    ".sl{font-size:14px;font-weight:800;color:#000000}" &
