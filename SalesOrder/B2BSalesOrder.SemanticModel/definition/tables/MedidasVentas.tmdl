	measure '% Notas Credito' = ```
			DIVIDE ( [Notas Credito (cadena)], [Facturado (cadena)] )
			
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		displayFolder: Servicio Temporada
