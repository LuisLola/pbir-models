	measure 'Servido (cadena)' =
			
			VAR Corte = [FechaLimiteSeleccionada]
			VAR OrdKeys =
			    FILTER (
			        VALUES ( LOL_PBIB2BSALESORDER[KPedidoLinea] ),
			        NOT ISBLANK ( LOL_PBIB2BSALESORDER[KPedidoLinea] )
			    )
			RETURN
			CALCULATE (
			    [Importe Servido],
			    TREATAS ( OrdKeys, LOL_PBISALESDELIVERY[KAlbaranBase] ),
			    REMOVEFILTERS ( LOL_PBISALESDELIVERY ),
			    'LOL_PBISALESDELIVERY'[FechaDocumento] <= Corte
			)
		displayFolder: Servicio Temporada
		lineageTag: 92efa572-bb62-4118-adab-202c38a9e56b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Facturado (cadena)' =
			
			VAR Corte = [FechaLimiteSeleccionada]
			VAR OrdKeys =
			    FILTER (
			        VALUES ( LOL_PBIB2BSALESORDER[KPedidoLinea] ),
			        NOT ISBLANK ( LOL_PBIB2BSALESORDER[KPedidoLinea] )
			    )
			VAR DelvKeys =
			    CALCULATETABLE (
			        FILTER (
			            VALUES ( LOL_PBISALESDELIVERY[KAlbaranLinea] ),
			            NOT ISBLANK ( LOL_PBISALESDELIVERY[KAlbaranLinea] )
			        ),
			        TREATAS ( OrdKeys, LOL_PBISALESDELIVERY[KAlbaranBase] ),
			        REMOVEFILTERS ( LOL_PBISALESDELIVERY ),
			        'LOL_PBISALESDELIVERY'[FechaDocumento] <= Corte
			    )
			RETURN
			CALCULATE (
			    SUM ( 'LOL_PBIINVOICESSALES'[LineTotal_LC] ),
			    TREATAS ( DelvKeys, LOL_PBIINVOICESSALES[KFacturaBase] ),
			    REMOVEFILTERS ( LOL_PBIINVOICESSALES ),
			    'LOL_PBIINVOICESSALES'[DocDate] <= Corte
			)
		displayFolder: Servicio Temporada
		lineageTag: 9ae82633-f020-44d3-b3fc-15921e6e8f62

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Notas Credito (cadena)' =
			
			VAR Corte = [FechaLimiteSeleccionada]
			VAR OrdUIDs = VALUES ( LOL_PBIB2BSALESORDER[LineUID] )
			RETURN
			CALCULATE (
			    [Importe Notas Credito],
			    TREATAS ( OrdUIDs, LOL_PBICREDITNOTESSALES[LineUID] ),
			    REMOVEFILTERS ( LOL_PBICREDITNOTESSALES ),
			    'LOL_PBICREDITNOTESSALES'[DocDate] <= Corte
			)
		displayFolder: Servicio Temporada
		lineageTag: 3b5e0f79-b830-4e47-b6ce-7dec97b683b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

