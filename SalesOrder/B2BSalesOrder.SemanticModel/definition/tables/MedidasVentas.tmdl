	measure 'Devoluciones (cadena)' =
			VAR OrdUIDs = VALUES ( LOL_PBIB2BSALESORDER[LineUID] )
			RETURN
			CALCULATE (
			    [Importe Devoluciones],
			    TREATAS ( OrdUIDs, LOL_PBIRETURNSALES[LineUID] ),
			    REMOVEFILTERS ( LOL_PBIRETURNSALES )
			)
		displayFolder: Servicio Temporada
		lineageTag: e2f3a4b5-c6d7-48e9-0f1a-2b3c4d5e6f70

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Devoluciones' = DIVIDE ( [Devoluciones (cadena)], [Facturado (cadena)] )
		formatString: 0.00\ %;-0.00\ %;0.00\ %
