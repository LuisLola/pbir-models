	measure 'Notas + Devol. Abiertas (cadena)' =
			
			VAR Corte = [FechaLimiteSeleccionada]
			RETURN
			[Notas Credito (cadena)]
			    + CALCULATE (
			        [Importe Devoluciones],
			        TREATAS ( VALUES ( LOL_PBIB2BSALESORDER[LineUID] ), LOL_PBIRETURNSALES[LineUID] ),
			        REMOVEFILTERS ( LOL_PBIRETURNSALES ),
			        LOL_PBIRETURNSALES[LineStatus] = "O",
			        'LOL_PBIRETURNSALES'[DocDate] <= Corte
			    )
