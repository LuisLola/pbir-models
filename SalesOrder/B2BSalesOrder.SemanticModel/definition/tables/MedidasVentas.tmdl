		lineageTag: 52968285-2aa0-4fd6-a787-78c0b263a7d8

	measure RealizadoTemporadaAnterior_% = DIVIDE ( [VentasTemporadaSeleccionadaTotal], [VentasTemporadaAnterior_Total] )
		formatString: 0%;-0%;0%
		displayFolder: Temporada
		lineageTag: 86bf6539-8182-49a1-bb08-4fb3e7da22eb

	measure EvolTemporadaSeleccionada = [VentasTemporadaSeleccionadaTotal] - [VentasTemporadaAnterior]
		formatString: \€#,##0
		displayFolder: Evolucion
		lineageTag: 2ad9f123-45d6-4447-b84a-d2ee36d3d81a

	measure EvolTemporadaSeleccionada_% =
			VAR Actual = [VentasTemporadaSeleccionadaTotal]
			VAR Anterior = [VentasTemporadaAnterior]
			RETURN
			    IF (
			        NOT ISBLANK ( Anterior ) && Anterior <> 0,
			        DIVIDE ( Actual - Anterior, Anterior, 0 ),
			        BLANK ()
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Evolucion
		lineageTag: cc516872-04dd-48ea-b470-32a6b18344da

	measure EvolTemporadaSeleccionada_Completa = [VentasTemporadaSeleccionadaTotal] - [VentasTemporadaAnterior_SoloInicio]
		formatString: \€#,##0
		displayFolder: Evolucion
		lineageTag: 47f4718a-bda6-4cc4-9f5c-c2ced149d0ff

	measure EvolTemporadaSeleccionada_%Completa =
			VAR Actual = [VentasTemporadaSeleccionadaTotal]
			VAR Anterior = [VentasTemporadaAnterior_SoloInicio]
			RETURN
			    IF (
			        NOT ISBLANK ( Anterior ) && Anterior <> 0,
			        DIVIDE ( Actual - Anterior, Anterior, 0 ),
			        BLANK ()
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Evolucion
		lineageTag: 3729a0ba-d24b-45d6-a989-f9d085acf9e5

	measure VentasYTD =
			CALCULATE (
			    CALCULATE (
			        SUM ( 'LOL_PBIB2BSALESORDER'[LineTotal_Num] ),
			        'LOL_PBIB2BSALESORDER'[Canceled] <> "Y",
			        'LOL_PBIB2BSALESORDER'[IsIncidence] <> "Y"
			    ),
			    DATESYTD ( 'Calendario'[Date] )
			)
		formatString: \€#,##0
		displayFolder: YTD
		lineageTag: 3a2bd0de-9b59-42df-8817-6a01869b0d58

	measure VentasYTD_SalesOrder = [VentasYTD]
		formatString: \€#,##0
		displayFolder: YTD
		lineageTag: d55caeb7-641d-4e3c-94b9-0b733e4e5aef

	measure VentasYTD_LY =
			CALCULATE (
			    [VentasYTD],
			    SAMEPERIODLASTYEAR ( 'Calendario'[Date] )
			)
		formatString: \€#,##0
		displayFolder: YTD
		lineageTag: 7f00b46b-31b7-4926-867c-6a0831948e52

	measure EvolVentasYTD = [VentasYTD] - [VentasYTD_LY]
		formatString: \€#,##0
		displayFolder: YTD
		lineageTag: d9220f8e-e937-4a5c-a849-b4c7b4a00d6b

	measure EvolVentasYTD_% =
			VAR Actual = [VentasYTD]
			VAR Anterior = [VentasYTD_LY]
			RETURN
			    IF (
			        NOT ISBLANK ( Anterior ) && Anterior <> 0,
			        DIVIDE ( Actual - Anterior, Anterior, 0 ),
			        BLANK ()
			    )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: YTD
		lineageTag: af2f617f-f8af-4ae0-8a64-8701adff5d4c

