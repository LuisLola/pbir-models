	measure ValidacionVentasAnt_DiasEq_AllFact =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			VAR FechaInicioAnt = [ValidacionFechaInicioTemporadaAnt]
			VAR FechaFinAnt = [ValidacionFechaFinAntDiasEq]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel )
			            || ISBLANK ( TemporadaAnt )
			            || ISBLANK ( FechaInicioAnt )
			            || ISBLANK ( FechaFinAnt ),
			        BLANK (),
			        CALCULATE (
			            SUM ( 'LOL_PBIB2BSALESORDER'[ImporteBruto] ),
			            FILTER (
			                ALL ( 'LOL_PBIB2BSALESORDER' ),
			                'LOL_PBIB2BSALESORDER'[Season] = TemporadaAnt
			                    && 'LOL_PBIB2BSALESORDER'[DocDate] >= FechaInicioAnt
			                    && 'LOL_PBIB2BSALESORDER'[DocDate] <= FechaFinAnt
			            ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            TREATAS (
			                VALUES ( 'LOL_PBICLIENTES'[CodeCliente] ),
			                'LOL_PBIB2BSALESORDER'[CardCode]
			            )
			        )
			    )
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: 2f4a12a7-4cf0-435d-a37c-5622132bab50

