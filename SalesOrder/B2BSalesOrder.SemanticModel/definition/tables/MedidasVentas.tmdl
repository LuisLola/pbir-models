	measure VentasTemporadaSeleccionada =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR FechaCorte = [FechaLimiteSeleccionada]
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel ),
			        0,
			        CALCULATE (
			            SUM ( 'LOL_PBIB2BSALESORDER'[ImporteBruto] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'LOL_PBIB2BSALESORDER'[DocDate] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'LOL_PBIB2BSALESORDER'[Canceled] <> "Y",
			            'LOL_PBIB2BSALESORDER'[IsIncidence] <> "Y",
			            'LOL_PBIB2BSALESORDER'[Season] = TemporadaSel,
			            'LOL_PBIB2BSALESORDER'[DocDate] <= FechaCorte
			        )
			    )
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: 575ddabb-57d2-4566-b24d-3ca210296c61

	measure VentasTemporadaSeleccionadaSalesOrder = [VentasTemporadaSeleccionada]
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: a9f5dd08-af46-4578-8013-43f88fe0a57d

	measure VentasTemporadaAnterior =
			VAR TemporadaSel = [TemporadaSeleccionada]
			VAR TemporadaAnt = [TemporadaAnterior]
			VAR FechaInicioSel =
			    CALCULATE (
			        MAX ( 'LOL_PBISEASON'[Fin] ),
			        REMOVEFILTERS ( 'LOL_PBISEASON' ),
			        'LOL_PBISEASON'[Code] = TemporadaSel
			    )
			VAR FechaCorte = [FechaLimiteSeleccionada]
			VAR DiasTemporada = DATEDIFF ( FechaInicioSel, FechaCorte, DAY ) + 1
			VAR FechaInicioAnt =
			    CALCULATE (
			        MAX ( 'LOL_PBISEASON'[Fin] ),
			        REMOVEFILTERS ( 'LOL_PBISEASON' ),
			        'LOL_PBISEASON'[Code] = TemporadaAnt
			    )
			VAR FechaFinAnt = FechaInicioAnt + DiasTemporada - 1
			RETURN
			    IF (
			        ISBLANK ( TemporadaSel )
			            || ISBLANK ( TemporadaAnt )
			            || ISBLANK ( FechaInicioSel )
			            || ISBLANK ( FechaInicioAnt )
			            || FechaCorte < FechaInicioSel,
			        BLANK (),
			        CALCULATE (
			            SUM ( 'LOL_PBIB2BSALESORDER'[ImporteBruto] ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'LOL_PBIB2BSALESORDER'[DocDate] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'LOL_PBIB2BSALESORDER'[Season] = TemporadaAnt,
			            'LOL_PBIB2BSALESORDER'[DocDate] >= FechaInicioAnt,
			            'LOL_PBIB2BSALESORDER'[DocDate] <= FechaFinAnt
			        )
			    )
		formatString: \€#,##0
		displayFolder: Temporada
		lineageTag: c8aff2a2-21ce-4d21-acf8-ddc30061aecf

	measure VentasTemporadaAnterior_SoloInicio =
