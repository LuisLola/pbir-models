		lineageTag: f3a4b5c6-d7e8-49f0-1a2b-3c4d5e6f7081

	measure 'Notas + Devol. Abiertas (cadena)' =
			[Notas Credito (cadena)]
			    + CALCULATE (
			        [Importe Devoluciones],
			        TREATAS ( VALUES ( LOL_PBIB2BSALESORDER[LineUID] ), LOL_PBIRETURNSALES[LineUID] ),
			        REMOVEFILTERS ( LOL_PBIRETURNSALES ),
			        LOL_PBIRETURNSALES[LineStatus] = "O"
			    )
		displayFolder: Servicio Temporada
		lineageTag: b1c2d3e4-f5a6-47b8-c9d0-e1f2a3b4c5d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Importe Solicitudes Devolucion' = SUM ( 'LOL_PBIRETURNREQUESTS'[LineTotal_LC] )
