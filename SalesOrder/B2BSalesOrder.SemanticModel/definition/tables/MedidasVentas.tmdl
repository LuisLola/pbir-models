		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Solicitudes Devol. Abiertas' = CALCULATE ( [Importe Solicitudes Devolucion], 'LOL_PBIRETURNREQUESTS'[LineStatus] = "O" )
