			        BLANK (),
			        CALCULATE (
			            COUNTROWS ( 'LOL_PBIB2BSALESORDER' ),
			            REMOVEFILTERS ( 'Calendario' ),
			            REMOVEFILTERS ( 'LOL_PBIB2BSALESORDER'[DocDate] ),
			            REMOVEFILTERS ( 'LOL_PBISEASON' ),
			            'LOL_PBIB2BSALESORDER'[Season] = TemporadaAnt,
			            'LOL_PBIB2BSALESORDER'[DocDate] >= FechaInicioAnt,
			            'LOL_PBIB2BSALESORDER'[DocDate] <= FechaFinAnt
			        )
			    )
		formatString: #,##0
		displayFolder: Validacion
		lineageTag: 7b1721dd-e52e-4e97-96e1-0282b82fc443

	measure 'Pedido Final' = ```
			CALCULATE ( SUM ( 'LOL_PBIB2BSALESORDER'[ImporteBruto_LC]), 'LOL_PBIB2BSALESORDER'[IsIncidence] = "N" )
			
