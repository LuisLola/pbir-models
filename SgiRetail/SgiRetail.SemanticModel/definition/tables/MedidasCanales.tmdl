table MedidasCanales
	lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0001

	measure Ventas_YTD_ECI =
			CALCULATE(
				[Ventas_YTD],
				LOL_PBITIENDAS[TipoTienda] = "ECI"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0011

	measure Ventas_YTD_LY_ECI =
			CALCULATE(
				[Ventas_YTD_LY],
				LOL_PBITIENDAS[TipoTienda] = "ECI"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0012

	measure Ventas_YTD_Var_%_ECI =
			DIVIDE(
				[Ventas_YTD_ECI] - [Ventas_YTD_LY_ECI],
				[Ventas_YTD_LY_ECI]
			)
		formatString: 0%;-0%;0%
		lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0013

	measure Objetivos_YTD_ECI =
			CALCULATE(
				[Objetivos_YTD],
				LOL_PBITIENDAS[TipoTienda] = "ECI"
			)
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0014

	measure CumplimientoObjetivo_%_ECI =
			DIVIDE(
				[Ventas_YTD_ECI],
				[Objetivos_YTD_ECI]
			)
		formatString: 0%;-0%;0%
		lineageTag: aabbccdd-aa01-aa01-aa01-aabbccdd0015

	measure Ventas_YTD_Online =
