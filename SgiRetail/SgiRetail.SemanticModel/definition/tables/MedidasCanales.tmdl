	column Column
		formatString: 0
		lineageTag: aabbccdd-aa01-ccol-ccol-aabbccddcol1
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition MedidasCanales = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = aabbccddaa01aa01aa01aabbccdd0001

