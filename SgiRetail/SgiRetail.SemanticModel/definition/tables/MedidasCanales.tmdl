	measure Share_%_Tienda = DIVIDE([Ventas_YTD_Tienda], [Ventas_YTD])
		formatString: 0%
		lineageTag: aabbccdd-aa06-aa06-aa06-aabbccdd0061

	measure Share_%_ECI = DIVIDE([Ventas_YTD_ECI], [Ventas_YTD])
		formatString: 0%
		lineageTag: aabbccdd-aa06-aa06-aa06-aabbccdd0062

	measure Share_%_Online = DIVIDE([Ventas_YTD_Online], [Ventas_YTD])
		formatString: 0%
		lineageTag: aabbccdd-aa06-aa06-aa06-aabbccdd0063

	measure Share_%_Marketplace = DIVIDE([Ventas_YTD_Marketplace], [Ventas_YTD])
		formatString: 0%
		lineageTag: aabbccdd-aa06-aa06-aa06-aabbccdd0064

	measure ChannelHeader_Tienda =
			IF(
				ISBLANK([Ventas_YTD_Tienda]),
				"Tienda",
				"Tienda  " & FORMAT([Share_%_Tienda], "0%") & " del total"
			)
		formatString: @
		lineageTag: aabbccdd-aa07-aa07-aa07-aabbccdd0071

	measure ChannelHeader_ECI =
			IF(
				ISBLANK([Ventas_YTD_ECI]),
				"Corner ECI",
				"Corner ECI  " & FORMAT([Share_%_ECI], "0%") & " del total"
			)
		formatString: @
		lineageTag: aabbccdd-aa07-aa07-aa07-aabbccdd0072

	measure ChannelHeader_Online =
			IF(
				ISBLANK([Ventas_YTD_Online]),
				"Online",
				"Online  " & FORMAT([Share_%_Online], "0%") & " del total"
			)
		formatString: @
