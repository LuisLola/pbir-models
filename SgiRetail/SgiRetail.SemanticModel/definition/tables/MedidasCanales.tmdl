	measure Texto_Progreso_Tienda =
			VAR Pct = [CumplimientoObjetivo_%_Tienda]
			VAR OBJ = [Objetivos_YTD_Tienda]
			RETURN
				IF(ISBLANK(OBJ), BLANK(), FORMAT(Pct, "0%") & " del objetivo  ·  OBJ " & FORMAT(OBJ, "#,0"))
		formatString: @
		lineageTag: aabbccdd-aa10-aa10-aa10-aabbccdd0141

