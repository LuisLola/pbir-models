				"Marketplaces",
				"Marketplaces  " & FORMAT([Share_%_Marketplace], "0%") & " del total"
			)
		formatString: @
		lineageTag: aabbccdd-aa07-aa07-aa07-aabbccdd0074

	measure Pilla_VsOBJ_ECI =
			VAR Pct = [CumplimientoObjetivo_%_ECI] - 1
			VAR OBJ = [Objetivos_YTD_ECI]
			VAR Sign = IF(Pct >= 0, "+", "")
			RETURN
				IF(ISBLANK(OBJ), BLANK(), Sign & FORMAT(Pct, "0%") & " vs OBJ")
		formatString: @
		lineageTag: aabbccdd-aa08-aa08-aa08-aabbccdd0081

