table MedidasIndicadores
	lineageTag: aabbccdd-aa02-bb02-bb02-aabbccdd0002

	measure Texto_Objetivo =
			VAR Pct = [CumplimientoObjetivo_%]
			VAR OBJ = [Objetivos_YTD]
			VAR Icono = IF(Pct >= 1, "🟢 ✅", IF(Pct >= 0.8, "🟡 ⚠️", "🔴 ❌"))
			VAR PctFmt = FORMAT(Pct, "0%")
			VAR OBJFmt = FORMAT(OBJ, "#,0")
			RETURN
				IF(
					ISBLANK(OBJ),
					BLANK(),
					Icono & " " & PctFmt & "| OBJ. " & OBJFmt
				)
		formatString: @
		lineageTag: aabbccdd-aa02-bb02-bb02-aabbccdd0021

	measure Texto_LY =
			VAR Pct = [Ventas_YTD_Var_%]
			VAR LY = [Ventas_YTD_LY]
			VAR Icono = IF(Pct > 0, "🟢 📈", "🔴 📉")
			VAR PctSign = IF(Pct > 0, "+" & FORMAT(Pct, "0%"), FORMAT(Pct, "0%"))
			VAR LYFmt = FORMAT(LY, "#,0")
			RETURN
				IF(
					ISBLANK(LY),
					BLANK(),
					Icono & " " & PctSign & " vs PY " & LYFmt
				)
		formatString: @
		lineageTag: aabbccdd-aa02-bb02-bb02-aabbccdd0022

