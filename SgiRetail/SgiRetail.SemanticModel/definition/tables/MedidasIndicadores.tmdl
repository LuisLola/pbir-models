	/// El rango que se esta viendo y cuando se actualizo el dato,
	/// juntos para una sola tarjeta de cabecera.
	measure 'Rango y actualización' = [RangoPeriodoSeleccionado] & "   ·   " & [Última actualización]
		displayFolder: Actualización
		lineageTag: 4c1f8a2e-77b0-4c0e-9d21-6a5e3f9b1c04

	column Column
		formatString: 0
		lineageTag: aabbccdd-aa02-ccol-ccol-aabbccddcol2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition MedidasIndicadores = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = aabbccddaa02bb02bb02aabbccdd0002

