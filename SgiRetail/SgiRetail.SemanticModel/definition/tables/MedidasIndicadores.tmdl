	measure NombreTienda_Selected = SELECTEDVALUE(LOL_PBITIENDAS[NombreTienda], "— Selecciona tienda —")
		formatString: @
		lineageTag: aabbccdd-aa09-aa09-aa09-aabbccdd0094

	column Column
		formatString: 0
		lineageTag: aabbccdd-aa02-ccol-ccol-aabbccddcol2
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition MedidasIndicadores = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = aabbccddaa02bb02bb02aabbccdd0002

