	measure Pilla_VsOBJ_Total =
			VAR Pct = [EvolucionObjetivo_%]
			VAR OBJ = [Objetivos_YTD]
			VAR Sign = IF(Pct >= 0, "+", "")
			RETURN
				IF(ISBLANK(OBJ), BLANK(), Sign & FORMAT(Pct, "0%") & " vs OBJ")
		formatString: @
		lineageTag: aabbccdd-aa09-aa09-aa09-aabbccdd0091

