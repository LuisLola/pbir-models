						        DISTINCT( SELECTCOLUMNS( _detG, "@m", [@m] ) ),
						        "@img", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[URL_imagen_producto] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@cat", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Categoria] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
						        "@marca", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[GrupodeArt] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )
						    )
						VAR _det = NATURALLEFTOUTERJOIN( _detG, _info )
						VAR _cols =
						    CONCATENATEX(
						        { ( _A, 1 ), ( _B, 2 ) },
						        VAR _s = [Value1]
						        VAR _totS = SUMX( FILTER( _totT, [@t] = _s ), [@tt] )
						        VAR _bodyS =
						            CONCATENATEX(
						                _gTop,
						                VAR _gv = [@g]
						                VAR _gtS = SUMX( FILTER( _celdasT, [@g] = _gv && [@t] = _s ), [@stt] )
						                VAR _bloques =
						                    CONCATENATEX(
						                        FILTER( _cTop, [@g] = _gv ),
						                        VAR _sv = [@g2]
						                        VAR _stS = SUMX( FILTER( _celdasT, [@g] = _gv && [@g2] = _sv && [@t] = _s ), [@stt] )
						                        VAR _inG = FILTER( _det, [@g] = _gv && [@g2] = _sv && [@t] = _s )
						                        VAR _max = MAXX( _inG, [@v2] )
						                        VAR _cards =
						                            CONCATENATEX(
						                                TOPN( _TopN, _inG, [@v2], DESC ),
						                                VAR _m = [@m]
						                                VAR _ven = [@ven2]
						                                VAR _u = [@u2]
						                                VAR _v = [@v2]
						                                VAR _r = RANKX( _inG, [@v2], , DESC, DENSE )
						                                VAR _medal = SWITCH( _r, 1, "#DFA0C9", 2, "#000000", 3, "#8A8A8A", "#C9C9C9" )
						                                VAR _marca = [@marca]
						                                VAR _bu = UPPER( COALESCE( _marca, "" ) )
						                                VAR _bcol = SWITCH( TRUE(), _bu = "MAITE", "#DFA0C9", _bu = "LOLA", "#000000", "#8A8A8A" )
						                                VAR _cat = [@cat]
						                                VAR _sil = IF( _cat = "Accesorio", _silA, _silP )
						                                VAR _img = [@img]
						                                VAR _imgT = IF( NOT ISBLANK( _img ) && LEN( _img ) > 5, "<img src='" & _img & "' onerror=""this.style.display='none'"" />", "" )
						                                VAR _bp = INT( DIVIDE( _v, _max ) * 100 )
			
						                        RETURN
						                            "<div class='card'>" &
						                            "<div class='rank' style='background:" & _medal & "'>" & _r & "</div>" &
						                            "<div class='brand' style='background:" & _bcol & "'>" & COALESCE( _marca, "" ) & "</div>" &
						                            "<div class='ib'>" & IF( LEN( _imgT ) > 0, _imgT, _sil ) & "</div>" &
						                            "<div class='sku'>" & _m & "</div>" &
						                            "<div class='sl'>" & FORMAT( _ven, "#,##0", "es-ES" ) & " €</div>" &
						                            "<div class='bt'><div class='bf' style='width:" & _bp & "%'></div></div>" &
						                            "<div class='kp'>" & FORMAT( _u, "#,##0", "es-ES" ) & " uds</div>" &
						                            "</div>",
			                                "", [@v2], DESC
						                            )
						                        RETURN
						                            IF( LEN( _sv ) > 0,
						                                "<details class='sb' open><summary class='sub'><span class='st'>" & _sv & "</span><span class='se'>" & FORMAT( _stS, "#,##0", "es-ES" ) & " €</span></summary><div class='grid'>" & _cards & "</div></details>",
						                                "<div class='grid'>" & _cards & "</div>" ),
						                        "", [@st], DESC
						                    )
						                RETURN
						                    "<details class='sec' open><summary class='sh'><span class='t'>" & _gv & "</span><span class='e'>" & FORMAT( _gtS, "#,##0", "es-ES" ) & " €</span></summary>" & _bloques & "</details>",
						                "", [@gt], DESC
						            )
						        RETURN "<div class='col'><div class='ch'><span class='t'>" & COALESCE( _s, "—" ) & "</span><span class='e'>" & FORMAT( _totS, "#,##0", "es-ES" ) & " €</span></div>" & IF( LEN( _bodyS ) = 0, "<div class='empty'>Sin ventas.</div>", _bodyS ) & "</div>",
						        "", [Value2], ASC
						    )
						RETURN
						    _Css & IF( ISBLANK( _A ), "<div class='wrap'><div class='empty'>Elige UNA temporada en el segmentador.</div></div>", "<div class='wrap'><div class='cmp'>" & _cols & "</div></div>" )
						
			```
		displayFolder: Catálogo Fotos\2. Auxiliares
		lineageTag: de455c80-ae26-4324-9a77-04f88cefa4ec

	column Column
		formatString: 0
		lineageTag: 0a1b2c3d-0004-4f04-8a04-000000000004
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition MedidasCatalogo = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 0a1b2c3d000040f08a04000000000009

