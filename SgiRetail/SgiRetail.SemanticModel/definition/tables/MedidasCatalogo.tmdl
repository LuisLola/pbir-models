				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBITIENDAS[Territorio], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBITIENDAS[Territorio] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 3 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBITIENDAS[AreaManager], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBITIENDAS[AreaManager] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 4 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBIMODELITEM[Categoria], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBIMODELITEM[Categoria] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 5 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBIMODELITEM[Descripcion_familia_agregada], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBIMODELITEM[Descripcion_familia_agregada] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 6 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBIMODELITEM[Nombre_familia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBIMODELITEM[Nombre_familia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 7 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], LOL_PBIMODELITEM[Subfamilia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", LOL_PBIMODELITEM[Subfamilia] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 8 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], Calendario[Año], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", Calendario[Año] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 9 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], Calendario[MesTexto], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", Calendario[MesTexto] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 10 ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[NombreDíaCorto], Calendario[NombreSemana], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[NombreDíaCorto] & "", "@g2", Calendario[NombreSemana] & "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 12 && _ix2 = 11 )
				        ),
				        DATESBETWEEN( Calendario[Date], _ini, _hasta )
				    )
				VAR _pairs =
				    ADDCOLUMNS( _pairs0, "@v",
				        SWITCH( _ord,
				            "Unidades", [@u],
				            "PVP", VAR _mm = [@m]  VAR _t = CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )  RETURN IF( NOT ISBLANK( _t ) && LEN( _t ) > 0, DIVIDE( VALUE( SUBSTITUTE( _t, ".", "" ) ), 1000000 ), 0 ),
				            [@ven]
				        )
				    )
				/* --- primera y unica agregacion sobre la tabla cara --- */
				VAR _celdas =
				    GROUPBY( _pairs, [@g], [@g2],
				        "@st", SUMX( CURRENTGROUP(), [@ven] ),
				        "@mx", MAXX( CURRENTGROUP(), [@v] ),
				        "@nr", COUNTX( CURRENTGROUP(), 1 )
				    )
				VAR _groups =
				    GROUPBY( _celdas, [@g],
				        "@gt", SUMX( CURRENTGROUP(), [@st] ),
				        "@nref", SUMX( CURRENTGROUP(), [@nr] )
				    )
				VAR _gTop = TOPN( 12, FILTER( _groups, [@gt] > 0 ), [@gt], DESC )
				VAR _gKeys = SELECTCOLUMNS( _gTop, "@g", [@g] )
				VAR _cSel = FILTER( _celdas, [@st] > 0 && [@g] IN _gKeys )
				/* top 8 subgrupos por grupo, sobre una tabla ya pequena */
				VAR _cTop =
				    FILTER( _cSel,
				        VAR g = [@g]  VAR s = [@st]
				        RETURN COUNTROWS( FILTER( _cSel, [@g] = g && [@st] > s ) ) < 8
				    )
				VAR _cKeys = SELECTCOLUMNS( _cTop, "@g", [@g], "@g2", [@g2] )
				/* segunda y ultima vez que se mira la tabla cara: solo las celdas que se pintan.
				   El GROUPBY la materializa, asi que el render la recorre sin volver al UNION.
				   PARTITIONBY no vale aqui: no admite columnas creadas por funciones de tabla. */
				VAR _detG =
				    GROUPBY(
				        FILTER( _pairs, [@ven] > 0 && ( [@g], [@g2] ) IN _cKeys ),
				        [@g], [@g2], [@m],
				        "@ven2", SUMX( CURRENTGROUP(), [@ven] ),
				        "@u2", SUMX( CURRENTGROUP(), [@u] ),
				        "@v2", MAXX( CURRENTGROUP(), [@v] )
				    )
				/* Ficha del modelo UNA sola vez. Antes se resolvian siete CALCULATE por
				   tarjeta, y el mismo modelo se repite en muchas celdas. */
				VAR _info =
				    ADDCOLUMNS(
				        DISTINCT( SELECTCOLUMNS( _detG, "@m", [@m] ) ),
				        "@img", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[URL_imagen_producto] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@nom", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Descripcion_modelo] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@alias", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Alias] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@cat", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Categoria] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@fam", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[Nombre_familia] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@marca", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[GrupodeArt] ), LOL_PBIMODELITEM[Modelo-Color] = _mm ),
				        "@pvptxt", VAR _mm = [@m] RETURN CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )
				    )
				VAR _det = NATURALLEFTOUTERJOIN( _detG, _info )
				/* --- a partir de aqui, todo son tablas pequenas --- */
				VAR _Body =
				    CONCATENATEX(
				        _gTop,
				        VAR _gv = [@g]
				        VAR _gt = [@gt]
				        VAR _nref = [@nref]
				        VAR _bloques =
				            CONCATENATEX(
				                FILTER( _cTop, [@g] = _gv ),
				                VAR _sv = [@g2]
				                VAR _st = [@st]
				                VAR _max = [@mx]
				                VAR _inCell = FILTER( _det, [@g] = _gv && [@g2] = _sv )
				                VAR _cartas =
				                    CONCATENATEX(
				                        TOPN( _TopN, _inCell, [@v2], DESC ),
				                        VAR _m = [@m]
				                        VAR _v = [@v2]
				                        VAR _ven = [@ven2]
				                        VAR _u = [@u2]
				                        VAR _rank = RANKX( _inCell, [@v2], , DESC, DENSE )
				                        VAR _img = [@img]
				                        VAR _nom = [@nom]
				                        VAR _alias = [@alias]
				                        VAR _cat = [@cat]
				                        VAR _fam = [@fam]
				                        VAR _marca = [@marca]
				                        VAR _pvptxt = [@pvptxt]
				                        VAR _medal = SWITCH( _rank, 1, "#DFA0C9", 2, "#000000", 3, "#8A8A8A", "#C9C9C9" )
				                        VAR _bu = UPPER( COALESCE( _marca, "" ) )
				                        VAR _bcol = SWITCH( TRUE(), _bu = "MAITE", "#DFA0C9", _bu = "LOLA", "#000000", "#8A8A8A" )
				                        VAR _sil = IF( _cat = "Accesorio", _silA, _silP )
				                        VAR _pvp = IF( NOT ISBLANK( _pvptxt ) && LEN( _pvptxt ) > 0, DIVIDE( VALUE( SUBSTITUTE( _pvptxt, ".", "" ) ), 1000000 ) )
				                        VAR _bp = INT( DIVIDE( _v, _max ) * 100 )
				                        VAR _imgT = IF( NOT ISBLANK( _img ) && LEN( _img ) > 5, "<img src='" & _img & "' onerror=""this.style.display='none'"" />", "" )
				                        RETURN
				                            "<div class='card'>" &
				                            "<div class='rank' style='background:" & _medal & "'>" & _rank & "</div>" &
				                            "<div class='brand' style='background:" & _bcol & "'>" & COALESCE( _marca, "" ) & "</div>" &
				                            "<div class='ib'>" & IF( LEN( _imgT ) > 0, _imgT, _sil ) & "</div>" &
				                            "<div class='sku'>" & _m & "</div>" &
				                            "<div class='nm'>" & COALESCE( _nom, "" ) & "</div>" &
				                            "<div class='al'>" & COALESCE( _alias, "" ) & "</div>" &
				                            "<div class='mt'>" & COALESCE( _cat, "" ) & " · " & COALESCE( _fam, "" ) & "</div>" &
				                            "<div class='sl'>" & FORMAT( _ven, "#,##0", "es-ES" ) & " €</div>" &
				                            "<div class='bt'><div class='bf' style='width:" & _bp & "%'></div></div>" &
				                            "<div class='kp'><span>" & FORMAT( _u, "#,##0", "es-ES" ) & " uds</span><span>PVP " & IF( ISBLANK( _pvp ), "—", FORMAT( _pvp, "#,##0.00", "es-ES" ) & " €" ) & "</span></div>" &
				                            "</div>",
				                        "", [@v2], DESC
				                    )
				                RETURN
				                    IF( LEN( _sv ) > 0,
				                        "<details class='sb' open><summary class='sub'><span class='st'>" & _sv & "</span><span class='se'>" & FORMAT( _st, "#,##0", "es-ES" ) & " €</span></summary><div class='grid'>" & _cartas & "</div></details>",
				                        "<div class='grid'>" & _cartas & "</div>" ),
				                "", [@st], DESC
				            )
				        RETURN
				            "<details class='sec' open><summary class='sh'><div><span class='t'>" & _gv & "</span><span class='n'>" & _nref & " ref.</span></div><span class='e'>" & FORMAT( _gt, "#,##0", "es-ES" ) & " €</span></summary>" & _bloques & "</details>",
				        "", [@gt], DESC
				    )
				RETURN
				    _Css & "<div class='wrap'>" & _Body & "</div>"
				
			```
		displayFolder: Catálogo Fotos\2. Auxiliares
		lineageTag: 384d978b-a978-49b6-9d8b-dbcd8aac8174

	measure 'TEST FOTO PUBLICA' =
			
			"<img src='https://upload.wikimedia.org/wikipedia/commons/3/3f/JPEG_example_flower.jpg'
			style='width:200px;height:260px;object-fit:cover;border-radius:12px;' />"
		displayFolder: Catálogo Fotos\2. Auxiliares
		lineageTag: a08cbcf2-fdb2-460a-a7a0-3e6050ae2e12

	measure 'HTML Comparador Temporadas' = ```
						
						VAR _TopN = [Catálogo Top N]
						VAR _ix = SELECTEDVALUE( DimensionesB2C1[DimensionesB2C1 Orden], 0 )
						VAR _ord = SELECTEDVALUE( OrdenSelector[Orden], "Ventas (€)" )
						VAR _A = SELECTEDVALUE( LOL_PBISEASON[Code] )
						VAR _B = SELECTEDVALUE( LOL_PBISEASON[CompareSeason] )
						VAR _Css =
						    "<style>" &
						    ".wrap{font-family:Manrope,'Segoe UI',Arial,sans-serif;background:transparent;color:#000000;padding:8px}" &
						    ".cmp{display:flex;gap:16px;align-items:flex-start}" &
						    ".col{flex:1;min-width:0}" &
						    ".ch{display:flex;align-items:baseline;justify-content:space-between;border-bottom:3px solid #DFA0C9;padding-bottom:5px;margin:0 0 12px;position:sticky;top:0;z-index:9;background:#FFFFFF}" &
						    ".ch .t{font-size:15px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.8px}" &
						    ".ch .e{font-size:15px;font-weight:800;color:#000000;padding:3px 12px;border-radius:9px;background:#FFFFFF}" &
						    ".sec{margin:0 0 12px}" &
						    ".sh{display:flex;align-items:center;justify-content:space-between;border-bottom:none;padding-bottom:3px;margin:0 0 9px;background:#DFA0C9;border-radius:9px;padding:7px 12px}" &
						    "details.sec>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:34px;z-index:8;background:#DFA0C9}" &
						    "details.sec>summary::-webkit-details-marker{display:none}" &
						    "details.sec>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:16px;height:16px;min-width:16px;margin-right:7px;border-radius:5px;background:#000000;color:#FFFFFF;font-size:8px;font-weight:800}" &
						    "details.sec:not([open])>summary::before{content:'\25B6';background:#000000;color:#FFFFFF}" &
						    "details.sec>summary:hover::before{outline:2px solid #000000;outline-offset:1px}" &
						    ".sh .t{font-size:15px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.8px}" &
						    ".sh .e{font-size:16px;font-weight:800;color:#000000;background:#FFFFFF;padding:4px 14px;border-radius:10px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.16)}" &
						    ".sub{display:flex;align-items:center;justify-content:space-between;margin:10px 0 6px;border-left:4px solid #DFA0C9;padding-left:6px;background:#F2F2F2;border-radius:0 8px 8px 0;padding:5px 10px}" &
						    ".sub .st{font-size:12px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.3px}" &
						    ".sub .se{font-size:13px;font-weight:800;color:#000000;background:#FFFFFF;padding:3px 11px;border-radius:9px;white-space:nowrap;box-shadow:0 1px 2px rgba(0,0,0,.10)}" &
						    "details.sb>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:75px;z-index:7;background:#F2F2F2}" &
						    "details.sb>summary::-webkit-details-marker{display:none}" &
						    "details.sb>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:13px;height:13px;min-width:13px;margin-right:5px;border-radius:4px;background:#8A8A8A;color:#FFFFFF;font-size:7px;font-weight:800}" &
						    "details.sb:not([open])>summary::before{content:'\25B6';background:#8A8A8A;color:#FFFFFF}" &
						    ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:7px}" &
						    ".card{position:relative;background:#fff;border:1px solid #E9E9E9;border-radius:9px;padding:6px;box-shadow:0 1px 2px rgba(0,0,0,.08)}" &
						    ".rank{position:absolute;top:8px;left:8px;width:18px;height:18px;border-radius:5px;color:#fff;font-weight:800;font-size:9px;display:flex;align-items:center;justify-content:center;z-index:2}" &
						    ".brand{position:absolute;top:8px;right:8px;color:#fff;font-size:7px;font-weight:700;padding:1px 4px;border-radius:7px;z-index:2}" &
						    ".ib{position:relative;aspect-ratio:3/4;border-radius:6px;border:1px solid #E9E9E9;background:#F2F2F2;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:4px}" &
						    ".ib img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}" &
						    ".sil{width:28px;height:28px}" &
						    ".sku{font-family:Consolas,monospace;font-size:8px;color:#8A8A8A}" &
						    ".sl{font-size:16px;font-weight:800;color:#000000}" &
						    ".bt{height:4px;background:#E9E9E9;border-radius:3px;margin:3px 0;overflow:hidden}" &
						    ".bf{height:4px;background:#DFA0C9;border-radius:3px}" &
						    ".kp{font-size:8px;color:#8A8A8A}" &
						    ".empty{font-size:11px;color:#8A8A8A;padding:8px}" &
						    "</style>"
						VAR _silP = "<svg class='sil' viewBox='0 0 48 48' fill='none' stroke='#C9C9C9' stroke-width='2' stroke-linejoin='round'><path d='M19 7 L11 13 L14 20 L19 17 L19 41 L29 41 L29 17 L34 20 L37 13 L29 7 Q24 11 19 7 Z'/></svg>"
						VAR _silA = "<svg class='sil' viewBox='0 0 48 48' fill='none' stroke='#C9C9C9' stroke-width='2' stroke-linejoin='round'><path d='M14 19 L34 19 L36 41 L12 41 Z'/><path d='M20 19 Q20 11 24 11 Q28 11 28 19'/></svg>"
						VAR _ix2 = SELECTEDVALUE( DimensionesB2C2[DimensionesB2C2 Orden] )
						VAR _unNivel = ISBLANK( _ix2 ) || _ix2 = _ix
						VAR _f1Ventana = [FechaInicioPeriodoSeleccionado]
						VAR _f2Ventana = [FechaHastaSeleccionada]
						VAR _pairs0 =
						    CALCULATETABLE(
						        UNION(
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[TipoTienda], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[TipoTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 0 && _unNivel ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[NombreTienda], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[NombreTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 1 && _unNivel ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[ResponsableTienda], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[ResponsableTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 2 && _unNivel ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[Territorio], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[Territorio] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 3 && _unNivel ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[AreaManager], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[AreaManager] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 4 && _unNivel ),
						            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBIMODELITEM[Categoria], LOL_PBIMODELITEM[Modelo-Color], LOL_PBISGIRETAIL[Temporada] ), "v", [Ventas], "u", [Cantidad] ), "@g", LOL_PBIMODELITEM[Categoria] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@t", LOL_PBISGIRETAIL[Temporada], "@ven", [v], "@u", [u] ), _ix = 5 && _unNivel ),
