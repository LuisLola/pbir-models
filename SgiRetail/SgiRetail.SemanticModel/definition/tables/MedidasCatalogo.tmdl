					))
						VAR _pairs =
						    ADDCOLUMNS( _pairs0, "@v",
						        SWITCH( _ord,
						            "Unidades", [@u],
						            "PVP", VAR _mm = [@m]  VAR _tp = CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ), LOL_PBIMODELITEM[Modelo-Color] = _mm )  RETURN IF( NOT ISBLANK( _tp ) && LEN( _tp ) > 0, DIVIDE( VALUE( SUBSTITUTE( _tp, ".", "" ) ), 1000000 ), 0 ),
						            [@ven]
						        )
						    )
						/* primera pasada: celdas por temporada. De aqui salen los totales de columna,
						   las secciones compartidas y los subtotales, todo sin volver a la tabla cara. */
						VAR _celdasT = GROUPBY( _pairs, [@g], [@g2], [@t], "@stt", SUMX( CURRENTGROUP(), [@ven] ) )
						VAR _celdas = GROUPBY( _celdasT, [@g], [@g2], "@st", SUMX( CURRENTGROUP(), [@stt] ) )
						VAR _groups = GROUPBY( _celdas, [@g], "@gt", SUMX( CURRENTGROUP(), [@st] ) )
						VAR _totT = GROUPBY( _celdasT, [@t], "@tt", SUMX( CURRENTGROUP(), [@stt] ) )
						/* secciones COMPARTIDAS: se eligen sobre las dos temporadas juntas, para que
						   las dos columnas enseñen lo mismo y se puedan comparar de un vistazo */
						VAR _gTop = TOPN( 6, FILTER( _groups, [@gt] > 0 ), [@gt], DESC )
						VAR _gKeys = SELECTCOLUMNS( _gTop, "@g", [@g] )
						VAR _cSel = FILTER( _celdas, [@st] > 0 && [@g] IN _gKeys )
						VAR _cTop =
						    FILTER( _cSel,
						        VAR g = [@g]  VAR s = [@st]
						        RETURN COUNTROWS( FILTER( _cSel, [@g] = g && [@st] > s ) ) < 4
						    )
