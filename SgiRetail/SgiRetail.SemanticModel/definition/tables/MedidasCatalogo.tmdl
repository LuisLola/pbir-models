table MedidasCatalogo
	lineageTag: 0a1b2c3d-0000-4f00-8a00-000000000000

	/// Top N de productos por Tipo de Tienda. Conectado al segmentador ParamTopN[Top N]; si no hay selección usa 10 por defecto. Lo consumen Catálogo HTML Productos y Catálogo HTML Tabla.
	measure 'Catálogo Top N' = SELECTEDVALUE( ParamTopN[Top N], 10 )
		displayFolder: Catálogo Fotos\1. Configuración
		lineageTag: 0a1b2c3d-0001-4f01-8a01-000000000001

	/// Catálogo visual de productos con foto, agrupado por Tipo de Tienda (TIENDA, CORNER ECI, ONLINE) y ordenado por importe. Devuelve HTML: usar en el visual "HTML Content". Respeta todos los filtros del informe.
	measure 'Catálogo HTML Productos' =
			VAR _TopN = [Catálogo Top N]
			// --- Grupos: código real en el modelo, etiqueta visible y orden ---
			//     OJO: el código real de "Corner ECI" en el modelo es "CORNER".
			VAR _Grupos =
				DATATABLE(
					"Cod", STRING, "Etiqueta", STRING, "Orden", INTEGER,
					{
						{ "TIENDA", "TIENDA", 1 },
						{ "CORNER", "CORNER ECI", 2 },
						{ "ONLINE", "ONLINE", 3 }
					}
				)
			// ----------------------------- CSS -----------------------------
			VAR _Css =
				"<style>" &
				"*{box-sizing:border-box}" &
				".cat{font-family:'Segoe UI',Arial,sans-serif;background:#fff;color:#222;padding:6px}" &
				".cat-grp{margin:0 0 16px}" &
				".cat-h{font-size:13px;font-weight:700;color:#1F4E79;letter-spacing:.5px;border-bottom:2px solid #1F4E79;padding-bottom:3px;margin:4px 0 8px}" &
				".cat-h span{font-weight:400;color:#9aa;font-size:11px}" &
				".cat-row{display:flex;flex-wrap:wrap;gap:8px}" &
				".cat-c{width:118px;border:1px solid #e6e6e6;border-radius:6px;background:#fff;padding:6px;box-shadow:0 1px 2px rgba(0,0,0,.06)}" &
				".cat-c img{width:100%;height:120px;object-fit:cover;border:1px solid #1F4E79;border-radius:4px;background:#f7f7f7;display:block}" &
				".cat-ni{width:100%;height:120px;border:1px solid #1F4E79;border-radius:4px;background:#f2f2f2;color:#bbb;font-size:9px;display:flex;align-items:center;justify-content:center}" &
				".cat-sku{font-size:11px;font-weight:700;margin-top:5px;line-height:1.2}" &
				".cat-br{font-size:10px;font-weight:600;color:#1F4E79}" &
				".cat-mt{font-size:9px;color:#777;line-height:1.25;margin:2px 0}" &
				".cat-pvp{font-size:10px;color:#444}" &
				".cat-imp{font-size:12px;font-weight:700;color:#1B5E20}" &
				".cat-u{font-size:9px;color:#999}" &
				"</style>"
			// ------------------- Construcción de grupos --------------------
			VAR _Html =
				CONCATENATEX(
					_Grupos,
					VAR _cod = [Cod]
					VAR _et = [Etiqueta]
					// 1) Top N modelos del grupo por Ventas (cálculo ligero)
					VAR _TopBase =
						CALCULATETABLE(
							TOPN(
								_TopN,
								ADDCOLUMNS( VALUES( LOL_PBIMODELITEM[Referencia_modelo] ), "@Imp", [Ventas] ),
								[@Imp], DESC
							),
							KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod )
						)
					// 2) Solo a los supervivientes les añadimos atributos (eficiente)
					VAR _Prod =
						ADDCOLUMNS(
							_TopBase,
							"@Uni", CALCULATE( [Cantidad], KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod ) ),
							"@Img", CALCULATE( MAX( LOL_PBIMODELITEM[URL_imagen_producto] ) ),
							"@Marca", CALCULATE( MAX( LOL_PBIMODELITEM[GrupodeArt] ) ),
							"@Fam", CALCULATE( MAX( LOL_PBIMODELITEM[Nombre_familia] ) ),
							"@Cat", CALCULATE( MAX( LOL_PBIMODELITEM[Categoria] ) ),
							"@Pvp", CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ) ),
							"@Tienda",
								CALCULATE(
									MAXX( TOPN( 1, VALUES( LOL_PBITIENDAS[NombreTienda] ), [Ventas], DESC ), LOL_PBITIENDAS[NombreTienda] ),
									KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod )
								)
						)
					// 3) Tarjetas (ordenadas por Importe desc)
					VAR _Cards =
						CONCATENATEX(
							FILTER( _Prod, [@Imp] > 0 ),
							VAR _img = [@Img]
							VAR _imgHtml =
								IF(
									NOT ISBLANK( _img ) && LEN( _img ) > 5,
									"<img src='" & _img & "' onerror=""this.outerHTML='<div class=&quot;cat-ni&quot;>sin imagen</div>'"" />",
									"<div class='cat-ni'>sin imagen</div>"
								)
							RETURN
								"<div class='cat-c'>" &
								_imgHtml &
								"<div class='cat-sku'>" & [Referencia_modelo] & "</div>" &
								"<div class='cat-br'>" & COALESCE( [@Marca], "" ) & "</div>" &
								"<div class='cat-mt'>" & COALESCE( [@Cat], "" ) & " · " & COALESCE( [@Fam], "" ) & "<br>" & COALESCE( [@Tienda], "" ) & "</div>" &
								"<div class='cat-pvp'>PVP " & COALESCE( [@Pvp], "" ) & "</div>" &
								"<div class='cat-imp'>" & FORMAT( [@Imp], "#,##0", "es-ES" ) & " €</div>" &
								"<div class='cat-u'>" & FORMAT( [@Uni], "#,##0", "es-ES" ) & " uds</div>" &
								"</div>",
							"",
							[@Imp], DESC
						)
					RETURN
						"<div class='cat-grp'>" &
						"<div class='cat-h'>" & _et & " <span>(Top " & _TopN & ")</span></div>" &
						"<div class='cat-row'>" &
						IF( LEN( _Cards ) = 0, "<div class='cat-mt'>Sin ventas en el periodo.</div>", _Cards ) &
						"</div></div>",
					"",
					[Orden], ASC
				)
			RETURN
				_Css & "<div class='cat'>" & _Html & "</div>"
		displayFolder: Catálogo Fotos
		lineageTag: 0a1b2c3d-0002-4f02-8a02-000000000002

	/// Auxiliar reutilizable: devuelve el <img> HTML (con borde azul y respaldo "sin imagen") del producto en el contexto actual. Útil dentro de una matriz con "HTML Content" o para tooltips.
	measure 'Catálogo Imagen HTML' =
			VAR _img = MAX( LOL_PBIMODELITEM[URL_imagen_producto] )
			RETURN
				IF(
					NOT ISBLANK( _img ) && LEN( _img ) > 5,
					"<img src='" & _img & "' style='width:100%;height:120px;object-fit:cover;border:1px solid #1F4E79;border-radius:4px' onerror=""this.outerHTML='<div style=&quot;color:#bbb;font-size:9px;padding:40px 0;text-align:center&quot;>sin imagen</div>'"" />",
					"<div style='color:#bbb;font-size:9px;padding:40px 0;text-align:center'>sin imagen</div>"
				)
		displayFolder: Catálogo Fotos\2. Auxiliares
		lineageTag: 0a1b2c3d-0003-4f03-8a03-000000000003

	/// Versión "matriz" del catálogo: tabla HTML compacta por Tipo de Tienda (miniatura + modelo, marca, categoría/familia, tienda, PVP, uds, importe), ordenada por importe. Usar en el visual "HTML Content".
	measure 'Catálogo HTML Tabla' =
			VAR _TopN = [Catálogo Top N]
			VAR _Grupos =
				DATATABLE(
					"Cod", STRING, "Etiqueta", STRING, "Orden", INTEGER,
					{
						{ "TIENDA", "TIENDA", 1 },
						{ "CORNER", "CORNER ECI", 2 },
						{ "ONLINE", "ONLINE", 3 }
					}
				)
			VAR _Css =
				"<style>" &
				".ct{font-family:'Segoe UI',Arial,sans-serif;color:#222;padding:6px}" &
				".ct h4{font-size:13px;color:#1F4E79;margin:10px 0 4px;border-bottom:2px solid #1F4E79;padding-bottom:2px}" &
				".ct table{border-collapse:collapse;width:100%;font-size:11px}" &
				".ct th{background:#1F4E79;color:#fff;font-weight:600;text-align:left;padding:4px 6px}" &
				".ct td{border-bottom:1px solid #eee;padding:3px 6px;vertical-align:middle}" &
				".ct tr:nth-child(even) td{background:#fafafa}" &
				".ct .r{text-align:right}" &
				".ct .imp{font-weight:700;color:#1B5E20}" &
				".ct img{width:38px;height:38px;object-fit:cover;border:1px solid #1F4E79;border-radius:3px;display:block}" &
				".ct .ni{width:38px;height:38px;border:1px solid #1F4E79;border-radius:3px;background:#f2f2f2}" &
				"</style>"
			VAR _Html =
				CONCATENATEX(
					_Grupos,
					VAR _cod = [Cod]
					VAR _et = [Etiqueta]
					VAR _TopBase =
						CALCULATETABLE(
							TOPN(
								_TopN,
								ADDCOLUMNS( VALUES( LOL_PBIMODELITEM[Referencia_modelo] ), "@Imp", [Ventas] ),
								[@Imp], DESC
							),
							KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod )
						)
					VAR _Prod =
						ADDCOLUMNS(
							_TopBase,
							"@Uni", CALCULATE( [Cantidad], KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod ) ),
							"@Img", CALCULATE( MAX( LOL_PBIMODELITEM[URL_imagen_producto] ) ),
							"@Marca", CALCULATE( MAX( LOL_PBIMODELITEM[GrupodeArt] ) ),
							"@Fam", CALCULATE( MAX( LOL_PBIMODELITEM[Nombre_familia] ) ),
							"@Cat", CALCULATE( MAX( LOL_PBIMODELITEM[Categoria] ) ),
							"@Pvp", CALCULATE( MAX( LOL_PBIMODELITEM[PVP_ESPANA_Y_PORTUGAL] ) ),
							"@Tienda",
								CALCULATE(
									MAXX( TOPN( 1, VALUES( LOL_PBITIENDAS[NombreTienda] ), [Ventas], DESC ), LOL_PBITIENDAS[NombreTienda] ),
									KEEPFILTERS( LOL_PBITIENDAS[TipoTienda] = _cod )
								)
						)
					VAR _Rows =
						CONCATENATEX(
							FILTER( _Prod, [@Imp] > 0 ),
							VAR _img = [@Img]
							VAR _imgHtml =
								IF(
									NOT ISBLANK( _img ) && LEN( _img ) > 5,
									"<img src='" & _img & "' onerror=""this.outerHTML='<div class=&quot;ni&quot;></div>'"" />",
									"<div class='ni'></div>"
								)
							RETURN
								"<tr>" &
								"<td>" & _imgHtml & "</td>" &
								"<td>" & [Referencia_modelo] & "</td>" &
								"<td>" & COALESCE( [@Marca], "" ) & "</td>" &
								"<td>" & COALESCE( [@Cat], "" ) & " · " & COALESCE( [@Fam], "" ) & "</td>" &
								"<td>" & COALESCE( [@Tienda], "" ) & "</td>" &
								"<td class='r'>" & COALESCE( [@Pvp], "" ) & "</td>" &
								"<td class='r'>" & FORMAT( [@Uni], "#,##0", "es-ES" ) & "</td>" &
								"<td class='r imp'>" & FORMAT( [@Imp], "#,##0", "es-ES" ) & " €</td>" &
								"</tr>",
							"",
							[@Imp], DESC
						)
					RETURN
						"<h4>" & _et & " (Top " & _TopN & ")</h4>" &
						IF(
							LEN( _Rows ) = 0,
							"<div style='font-size:10px;color:#999'>Sin ventas en el periodo.</div>",
							"<table><thead><tr><th></th><th>Modelo</th><th>Marca</th><th>Categoría / Familia</th><th>Tienda</th><th class='r'>PVP</th><th class='r'>Uds</th><th class='r'>Importe</th></tr></thead><tbody>" & _Rows & "</tbody></table>"
						),
					"",
					[Orden], ASC
				)
			RETURN
				_Css & "<div class='ct'>" & _Html & "</div>"
		displayFolder: Catálogo Fotos
		lineageTag: 0a1b2c3d-0005-4f05-8a05-000000000005

	measure 'HTML Catálogo' = ```
				
				VAR _TopN = [Catálogo Top N]
				VAR _ix = SELECTEDVALUE( DimensionesB2C1[DimensionesB2C1 Orden], 0 )
				VAR _ord = SELECTEDVALUE( OrdenSelector[Orden], "Ventas (€)" )
				VAR _ini = [FechaInicioPeriodoSeleccionado]
				VAR _hasta = [FechaHastaSeleccionada]
				VAR _Css =
				    "<style>" &
				    ".wrap{font-family:Manrope,'Segoe UI',Arial,sans-serif;background:transparent;color:#000000;padding:8px}" &
				    ".sec{margin:0 0 12px}" &
				    ".sh{display:flex;align-items:center;justify-content:space-between;border-bottom:none;padding-bottom:3px;margin:0 0 9px;background:#DFA0C9;border-radius:9px;padding:7px 12px}" &
				    ".sh .t{font-size:15px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.8px}" &
				    ".sh .n{font-size:9px;color:#000000;margin-left:7px;font-weight:600}" &
				    ".sh .e{font-size:16px;font-weight:800;color:#000000;background:#FFFFFF;padding:4px 14px;border-radius:10px;white-space:nowrap;box-shadow:0 1px 3px rgba(0,0,0,.16)}" &
				    ".sub{display:flex;align-items:center;justify-content:space-between;margin:10px 0 6px;border-left:4px solid #DFA0C9;padding-left:6px;background:#F2F2F2;border-radius:0 8px 8px 0;padding:5px 10px}" &
				    ".sub .st{font-size:12px;font-weight:800;color:#000000;text-transform:uppercase;letter-spacing:.3px}" &
				    ".sub .se{font-size:13px;font-weight:800;color:#000000;background:#FFFFFF;padding:3px 11px;border-radius:9px;white-space:nowrap;box-shadow:0 1px 2px rgba(0,0,0,.10)}" &
				    "details.sec>summary,details.sb>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:41px;z-index:6;background:#F2F2F2}" &
				    "details.sec>summary::-webkit-details-marker,details.sb>summary::-webkit-details-marker{display:none}" &
				    "details.sec>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:0;z-index:7;background:#DFA0C9}" &
				    "details.sb>summary{cursor:pointer;list-style:none;user-select:none;position:sticky;top:41px;z-index:6;background:#F2F2F2}" &
				    "details.sec>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;min-width:20px;margin-right:9px;border-radius:6px;background:#000000;color:#FFFFFF;font-size:10px;font-weight:800}" &
				    "details.sec:not([open])>summary::before{content:'\25B6';background:#000000;color:#FFFFFF}" &
				    "details.sec>summary:hover::before{outline:2px solid #000000;outline-offset:1px}" &
				    "details.sb>summary::before{content:'\25BC';display:inline-flex;align-items:center;justify-content:center;width:15px;height:15px;min-width:15px;margin-right:7px;border-radius:4px;background:#8A8A8A;color:#FFFFFF;font-size:8px;font-weight:800}" &
				    "details.sb:not([open])>summary::before{content:'\25B6';background:#8A8A8A;color:#FFFFFF}" &
				    "details.sb>summary:hover::before{outline:2px solid #8A8A8A;outline-offset:1px}" &
				    ".grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(108px,1fr));gap:7px}" &
				    ".card{position:relative;background:#fff;border:1px solid #E9E9E9;border-radius:9px;padding:6px;box-shadow:0 1px 2px rgba(0,0,0,.08)}" &
				    ".rank{position:absolute;top:8px;left:8px;width:18px;height:18px;border-radius:5px;color:#fff;font-weight:800;font-size:9px;display:flex;align-items:center;justify-content:center;z-index:2}" &
				    ".brand{position:absolute;top:8px;right:8px;color:#fff;font-size:7px;font-weight:700;padding:1px 4px;border-radius:7px;z-index:2}" &
				    ".ib{position:relative;aspect-ratio:3/4;border-radius:6px;border:1px solid #E9E9E9;background:#F2F2F2;display:flex;align-items:center;justify-content:center;overflow:hidden;margin-bottom:4px}" &
				    ".ib img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}" &
				    ".sil{width:28px;height:28px}" &
				    ".cap{position:absolute;bottom:5px;left:0;right:0;text-align:center;font-size:7px;letter-spacing:.8px;color:#8A8A8A;text-transform:uppercase}" &
				    ".sku{font-family:Consolas,monospace;font-size:8px;color:#8A8A8A}" &
				    ".nm{font-size:11px;font-weight:700;line-height:1.15;margin:2px 0 1px}" &
				    ".al{font-size:8px;color:#8A8A8A;font-style:italic;margin:0 0 2px;min-height:10px}" &
				    ".mt{font-size:9px;color:#8A8A8A;margin-bottom:5px}" &
				    ".sl{font-size:16px;font-weight:800;color:#000000}" &
				    ".bt{height:4px;background:#E9E9E9;border-radius:3px;margin:3px 0;overflow:hidden}" &
				    ".bf{height:4px;background:#DFA0C9;border-radius:3px}" &
				    ".kp{display:flex;justify-content:space-between;font-size:9px}" &
				    "</style>"
				VAR _silP = "<svg class='sil' viewBox='0 0 48 48' fill='none' stroke='#C9C9C9' stroke-width='2' stroke-linejoin='round'><path d='M19 7 L11 13 L14 20 L19 17 L19 41 L29 41 L29 17 L34 20 L37 13 L29 7 Q24 11 19 7 Z'/></svg>"
				VAR _silA = "<svg class='sil' viewBox='0 0 48 48' fill='none' stroke='#C9C9C9' stroke-width='2' stroke-linejoin='round'><path d='M14 19 L34 19 L36 41 L12 41 Z'/><path d='M20 19 Q20 11 24 11 Q28 11 28 19'/></svg>"
				VAR _ix2 = SELECTEDVALUE( DimensionesB2C2[DimensionesB2C2 Orden] )
				VAR _unNivel = ISBLANK( _ix2 ) || _ix2 = _ix
				VAR _pairs0 =
				    CALCULATETABLE(
				        UNION(
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[TipoTienda], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[TipoTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 0 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[NombreTienda], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[NombreTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 1 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[ResponsableTienda], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[ResponsableTienda] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 2 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[Territorio], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[Territorio] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 3 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBITIENDAS[AreaManager], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBITIENDAS[AreaManager] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 4 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBIMODELITEM[Categoria], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBIMODELITEM[Categoria] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 5 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBIMODELITEM[Descripcion_familia_agregada], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBIMODELITEM[Descripcion_familia_agregada] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 6 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBIMODELITEM[Nombre_familia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBIMODELITEM[Nombre_familia] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 7 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, LOL_PBIMODELITEM[Subfamilia], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", LOL_PBIMODELITEM[Subfamilia] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 8 && _unNivel ),
				            FILTER( SELECTCOLUMNS( ADDCOLUMNS( SUMMARIZE( LOL_PBISGIRETAIL, Calendario[Año], LOL_PBIMODELITEM[Modelo-Color] ), "ven", [Ventas], "u", [Cantidad] ), "@g", Calendario[Año] & "", "@g2", "", "@m", LOL_PBIMODELITEM[Modelo-Color], "@ven", [ven], "@u", [u] ), _ix = 9 && _unNivel ),
