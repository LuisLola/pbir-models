			VAR EA = CALCULATE([Entradas], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR TL = CALCULATE([NumeroTransacciones], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			VAR EL = CALCULATE([Entradas], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			RETURN DIVIDE(DIVIDE(TA, EA) - DIVIDE(TL, EL), DIVIDE(TL, EL))
