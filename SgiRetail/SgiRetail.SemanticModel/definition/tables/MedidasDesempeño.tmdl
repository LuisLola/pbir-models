	/// La linea de la primera tarjeta, como SVG. Va aparte para poder vaciarla
	/// sin tocar la tarjeta si el visual no la pinta.
	/// Coordenadas enteras a proposito: con es-ES, FORMAT con decimales mete
	/// coma y la lista de puntos del polyline deja de ser valida.
	measure 'HTML Spark Ventas' =
			VAR FIni = [FechaInicioPeriodoSeleccionado]
			VAR FFin = [FechaHastaSeleccionada]
			VAR Serie =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( Calendario[Date] ),
			            DATESBETWEEN ( Calendario[Date], FIni, FFin ) ),
			        "@v", CALCULATE ( [Ventas] ) + 0
			    )
			VAR N = COUNTROWS ( Serie )
			VAR Vmin = MINX ( Serie, [@v] )
			VAR Vmax = MAXX ( Serie, [@v] )
			VAR Rango = MAX ( Vmax - Vmin, 1 )
			VAR Ancho = MAX ( INT ( FFin ) - INT ( FIni ), 1 )
			VAR Pts =
			    CONCATENATEX (
			        Serie,
			        FORMAT ( ROUND ( DIVIDE ( INT ( Calendario[Date] ) - INT ( FIni ), Ancho ) * 96, 0 ), "0" )
			            & "," &
			        FORMAT ( ROUND ( 30 - DIVIDE ( [@v] - Vmin, Rango ) * 26, 0 ), "0" ),
			        " ", Calendario[Date], ASC
			    )
			RETURN
			    IF ( N >= 2,
			        "<svg viewBox='0 0 96 32' width='84' height='26' preserveAspectRatio='none'>"
			        & "<polyline points='" & Pts & "' fill='none' stroke='#C98496' stroke-width='1.1'"
			        & " stroke-linejoin='round' stroke-linecap='round'/></svg>"
			    )
		displayFolder: 9 HTML
		lineageTag: 1275e8ff-59d8-4b62-af4c-a68c4dadbec3

	/// Las cuatro tarjetas KPI del diseno, en una sola medida.
	/// Sustituye a 28 visuales por juego (56 contando los dos anchos del menu).
	/// Las pildoras son Ano / Mes / Semana / Dia; la etiqueta del periodo va en
	/// el title, que el diseno no deja sitio para escribirla.
	measure 'HTML Tarjetas Desempeño' =
			VAR EstiloPill = "display:inline-block;height:24px;line-height:24px;padding:0 8px;border-radius:3px;font-size:13px;font-weight:600;margin-right:6px;"
			VAR v1 = [Ventas_YTD]
			VAR t1 =
			    SWITCH ( TRUE (),
			        ISBLANK ( v1 ), "—",
			        ABS ( v1 ) >= 1000000, "€ " & FORMAT ( v1 / 1000000, "#,0.0" ) & " M",
			        ABS ( v1 ) >= 1000, "€ " & FORMAT ( v1 / 1000, "#,0" ) & " mil",
			        "€ " & FORMAT ( v1, "#,0" ) )
			VAR d11 = [VN_Evol_Anio]
			VAR p11 =
			    IF ( ISBLANK ( d11 ),
			        "<span style='" & EstiloPill & "background:#F0F1F3;color:#6B6F76'>—</span>",
			        "<span title='" & [Lbl_Anio] & "' style='" & EstiloPill & "background:"
			            & IF ( d11 < 0, "#F7D7DD", "#D7EFE0" ) & ";color:"
			            & IF ( d11 < 0, "#B0243F", "#1E7A45" ) & "'>"
			            & IF ( d11 < 0, UNICHAR ( 9662 ), UNICHAR ( 9652 ) ) & " "
			            & FORMAT ( ABS ( d11 ), "0%" ) & "</span>" )
			VAR d12 = [VN_Evol_Mes]
			VAR p12 =
			    IF ( ISBLANK ( d12 ),
			        "<span style='" & EstiloPill & "background:#F0F1F3;color:#6B6F76'>—</span>",
			        "<span title='" & [Lbl_Mes] & "' style='" & EstiloPill & "background:"
			            & IF ( d12 < 0, "#F7D7DD", "#D7EFE0" ) & ";color:"
			            & IF ( d12 < 0, "#B0243F", "#1E7A45" ) & "'>"
			            & IF ( d12 < 0, UNICHAR ( 9662 ), UNICHAR ( 9652 ) ) & " "
			            & FORMAT ( ABS ( d12 ), "0%" ) & "</span>" )
			VAR d13 = [VN_Evol_Sem]
			VAR p13 =
			    IF ( ISBLANK ( d13 ),
			        "<span style='" & EstiloPill & "background:#F0F1F3;color:#6B6F76'>—</span>",
			        "<span title='" & [Lbl_Sem] & "' style='" & EstiloPill & "background:"
			            & IF ( d13 < 0, "#F7D7DD", "#D7EFE0" ) & ";color:"
			            & IF ( d13 < 0, "#B0243F", "#1E7A45" ) & "'>"
			            & IF ( d13 < 0, UNICHAR ( 9662 ), UNICHAR ( 9652 ) ) & " "
			            & FORMAT ( ABS ( d13 ), "0%" ) & "</span>" )
			VAR d14 = [VN_Evol_Dia]
			VAR p14 =
			    IF ( ISBLANK ( d14 ),
			        "<span style='" & EstiloPill & "background:#F0F1F3;color:#6B6F76'>—</span>",
			        "<span title='" & [Lbl_Dia] & "' style='" & EstiloPill & "background:"
			            & IF ( d14 < 0, "#F7D7DD", "#D7EFE0" ) & ";color:"
			            & IF ( d14 < 0, "#B0243F", "#1E7A45" ) & "'>"
			            & IF ( d14 < 0, UNICHAR ( 9662 ), UNICHAR ( 9652 ) ) & " "
			            & FORMAT ( ABS ( d14 ), "0%" ) & "</span>" )
			VAR tarjeta1 =
			    "<div style='background:#FFFFFF;border:1px solid #E6E8EB;border-radius:4px;padding:18px 20px;box-sizing:border-box'>"
			    & "<div style='display:flex;align-items:flex-start;justify-content:space-between;gap:8px'>"
			    & "<div><div style='font-size:26px;font-weight:600;color:#1A1A1A;line-height:1.1'>"
			    & t1 & "</div>"
			    & "<div style='font-size:13px;font-weight:600;color:#6B6F76;margin-top:6px'>Venta neta con IVA</div></div>"
			    & "<div>" & [HTML Spark Ventas] & "</div></div>"
			    & "<div style='margin-top:14px;white-space:nowrap'>" & p11 & p12 & p13 & p14 & "</div></div>"
			VAR v2 = [PromedioVentaTransaccion_YTD]
			VAR t2 = IF ( ISBLANK ( v2 ), "—", "€ " & FORMAT ( v2, "#,##0.00" ) )
			VAR d21 = [TM_Evol_Anio]
