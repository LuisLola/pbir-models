	/// La tabla "Desempeno por".
	/// El nivel 1 lo manda el selector Desglose principal: una rama por cada
	/// una de las 14 opciones del parametro de campo. En DAX SWITCH no
	/// devuelve tablas, asi que se ramifica sobre el TEXTO generado.
	/// Cuesta 4,9 s frente a 253 ms con jerarquia fija: DAX materializa las 14
	/// ramas aunque solo use una. Hacer dinamico tambien el nivel 2 serian
	/// 196 ramas y 27,6 s, por eso el 2 se queda en NombreTienda.
	/// Cabecera fija arriba y Total fijo abajo, con scroll dentro.
	/// Los nombres llegan a 45 caracteres: columna de 260 px y title con el
	/// nombre completo.
	measure 'HTML Tabla Desempeño' =
			VAR S1 =
			    MINX (
			        TOPN ( 1, DimensionesB2C1, DimensionesB2C1[DimensionesB2C1 Orden], ASC ),
			        DimensionesB2C1[DimensionesB2C1]
			    )
			VAR Filas =
			    SWITCH ( S1,
			        "TipoTienda",
			        CONCATENATEX (
			            FILTER ( VALUES ( LOL_PBITIENDAS[TipoTienda] ),
			                S1 = "TipoTienda" && NOT ISBLANK ( [Ventas_YTD] ) ),
			            VAR h = CONCATENATEX ( FILTER ( VALUES ( LOL_PBITIENDAS[NombreTienda] ), NOT ISBLANK ( [Ventas_YTD] ) ), "<div class='s2'><span class='c n n2' title='" & LOL_PBITIENDAS[NombreTienda] & "'>" & LOL_PBITIENDAS[NombreTienda] & "</span>" & [HTML Fila Desempeño] & "</div>", "", [Ventas_YTD], DESC )
			            RETURN
			                IF ( h = "",
			                    "<div><span class='c n' title='" & LOL_PBITIENDAS[TipoTienda] & "'>" & LOL_PBITIENDAS[TipoTienda]
			                        & "</span>" & [HTML Fila Desempeño] & "</div>",
			                    "<details><summary><span class='c n gr' title='" & LOL_PBITIENDAS[TipoTienda]
			                        & "'>" & LOL_PBITIENDAS[TipoTienda] & "</span>" & [HTML Fila Desempeño]
			                        & "</summary>" & h & "</details>" ),
			            "", [Ventas_YTD], DESC
			        ),
			        "NombreTienda",
			        CONCATENATEX (
			            FILTER ( VALUES ( LOL_PBITIENDAS[NombreTienda] ),
			                S1 = "NombreTienda" && NOT ISBLANK ( [Ventas_YTD] ) ),
			            VAR h = ""
			            RETURN
			                IF ( h = "",
			                    "<div><span class='c n' title='" & LOL_PBITIENDAS[NombreTienda] & "'>" & LOL_PBITIENDAS[NombreTienda]
			                        & "</span>" & [HTML Fila Desempeño] & "</div>",
			                    "<details><summary><span class='c n gr' title='" & LOL_PBITIENDAS[NombreTienda]
			                        & "'>" & LOL_PBITIENDAS[NombreTienda] & "</span>" & [HTML Fila Desempeño]
			                        & "</summary>" & h & "</details>" ),
			            "", [Ventas_YTD], DESC
			        ),
			        "ResponsableTienda",
			        CONCATENATEX (
			            FILTER ( VALUES ( LOL_PBITIENDAS[ResponsableTienda] ),
			                S1 = "ResponsableTienda" && NOT ISBLANK ( [Ventas_YTD] ) ),
			            VAR h = CONCATENATEX ( FILTER ( VALUES ( LOL_PBITIENDAS[NombreTienda] ), NOT ISBLANK ( [Ventas_YTD] ) ), "<div class='s2'><span class='c n n2' title='" & LOL_PBITIENDAS[NombreTienda] & "'>" & LOL_PBITIENDAS[NombreTienda] & "</span>" & [HTML Fila Desempeño] & "</div>", "", [Ventas_YTD], DESC )
			            RETURN
			                IF ( h = "",
			                    "<div><span class='c n' title='" & LOL_PBITIENDAS[ResponsableTienda] & "'>" & LOL_PBITIENDAS[ResponsableTienda]
			                        & "</span>" & [HTML Fila Desempeño] & "</div>",
