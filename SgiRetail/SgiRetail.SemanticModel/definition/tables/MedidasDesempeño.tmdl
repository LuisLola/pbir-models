			        "<span style='" & EstiloPill & "background:#F0F1F3;color:#6B6F76'>—</span>",
			        "<span title='" & [Lbl_Dia] & "' style='" & EstiloPill & "background:"
			            & IF ( d44 < 0, "#F7D7DD", "#D7EFE0" ) & ";color:"
			            & IF ( d44 < 0, "#B0243F", "#1E7A45" ) & "'>"
			            & IF ( d44 < 0, UNICHAR ( 9662 ), UNICHAR ( 9652 ) ) & " "
			            & FORMAT ( ABS ( d44 ), "0%" ) & "</span>" )
			VAR tarjeta4 =
			    "<div style='background:#FFFFFF;border:1px solid #E6E8EB;border-radius:4px;padding:18px 20px;box-sizing:border-box'>"
			    & "<div style='display:flex;align-items:flex-start;justify-content:space-between;gap:8px'>"
			    & "<div><div style='font-size:26px;font-weight:600;color:#1A1A1A;line-height:1.1'>"
			    & t4 & "</div>"
			    & "<div style='font-size:13px;font-weight:600;color:#6B6F76;margin-top:6px'>% conversión</div></div>"
			    & "<div>" & "</div></div>"
			    & "<div style='margin-top:14px;white-space:nowrap'>" & p41 & p42 & p43 & p44 & "</div></div>"
			RETURN
			    "<div style='font-family:Manrope,system-ui,-apple-system,sans-serif;background:#F2F3F5;padding:2px 0'>"
			    & "<div style='font-size:19px;font-weight:600;color:#1A1A1A;margin:0 0 12px 0'>Resumen del periodo</div>"
			    & "<div style='display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px'>"
			    & tarjeta1 & tarjeta2 & tarjeta3 & tarjeta4
			    & "</div></div>"
		displayFolder: 9 HTML
		lineageTag: d38071d2-a0e0-46e4-b2e7-4ade7f4e8243

	/// El panel del menu. Solo el fondo, la regla y el pie: las etiquetas
	/// ya las pone la cabecera de cada segmentador, y repintarlas aqui
	/// seria duplicarlas y jugarsela al encaje.
	measure 'HTML Menu Lateral' =
			"<style>.mn{height:100%;min-height:720px;background:#6E2439;font-family:Manrope,system-ui,-apple-system,sans-serif;position:relative;box-sizing:border-box}.mn .rl{position:absolute;top:0;right:0;width:1px;height:100%;background:rgba(255,255,255,.14)}.mn .sp{position:absolute;left:14px;right:14px;top:70px;height:1px;background:rgba(255,255,255,.18)}.mn .ft{position:absolute;left:14px;right:14px;bottom:14px;color:#DFA0C9;font-size:10px;letter-spacing:.08em;text-transform:uppercase;opacity:.75}</style>"
			    & "<div class='mn'><div class='rl'></div><div class='sp'></div>"
			    & "<div class='ft'>" & [Rango y actualización] & "</div></div>"
		displayFolder: 9 HTML
		lineageTag: 23f64986-785b-4cbe-8fad-b3b8ed58ff12

	/// La pagina entera: menu, cabecera, filtros, tarjetas y tabla.
	/// Los desplegables NO filtran: el visual HTML no puede devolver una
	/// seleccion al modelo. Ensenan la seleccion vigente.
	/// Abrir y cerrar el menu si funciona, con un checkbox y CSS.
	measure 'HTML Página Desempeño' =
			VAR Css = "<style>*{margin:0;padding:0;box-sizing:border-box}.tg{display:none}.pg{position:relative;width:1280px;height:720px;background:#F2F3F5;font-family:Manrope,system-ui,-apple-system,sans-serif;color:#1A1A1A;overflow:hidden}.mn{position:absolute;left:0;top:0;bottom:0;width:62px;background:#6E2439;transition:width .18s ease;overflow:hidden;z-index:3}.tg:checked + .pg .mn{width:260px}.mn .lg{position:absolute;left:14px;top:14px;width:34px;height:34px;border-radius:50%;border:1.5px solid #fff;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;letter-spacing:.02em}.mn .wm{position:absolute;left:60px;top:22px;color:#fff;font-size:15px;letter-spacing:.06em;white-space:nowrap;opacity:0;transition:opacity .18s}.tg:checked + .pg .mn .wm{opacity:1}.mn .wm b{font-weight:800}.mn .wm i{font-style:normal;font-weight:300}.bt{position:absolute;left:14px;top:62px;width:34px;height:30px;color:#fff;font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center}.tg:checked + .pg .bt{left:auto;right:14px;top:18px}.fls{position:absolute;left:14px;right:14px;top:104px;opacity:0;pointer-events:none;transition:opacity .18s}.tg:checked + .pg .fls{opacity:1}.fl{margin-bottom:11px}.fl .lb{color:#DFA0C9;font-size:10.5px;font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fl .dd{height:30px;line-height:30px;background:#fff;border-radius:6px;padding:0 26px 0 10px;font-size:12px;color:#1A1A1A;position:relative;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fl .dd:after{content:'\25BE';position:absolute;right:9px;top:0;color:#6B6F76;font-size:10px}.ct{position:absolute;top:0;bottom:0;left:78px;right:0;padding:18px 22px;transition:left .18s ease;overflow:hidden}.tg:checked + .pg .ct{left:276px}.h1{font-size:26px;font-weight:700;letter-spacing:-.01em}.sub{font-size:11.5px;color:#6B6F76;margin-top:5px}.hd{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.ctl{display:flex;align-items:center;gap:10px;padding-top:4px}.ctl .lbl{font-size:11.5px;font-weight:600;color:#1A1A1A;white-space:nowrap}.db{height:30px;line-height:30px;background:#fff;border:1px solid #E6E8EB;border-radius:5px;padding:0 24px 0 10px;font-size:12px;position:relative;white-space:nowrap}.db:after{content:'\1F4C5';position:absolute;right:7px;top:0;font-size:11px;opacity:.6}.seg{display:flex;border:1px solid #E6E8EB;border-radius:5px;overflow:hidden;background:#fff}.seg span{padding:0 13px;height:28px;line-height:28px;font-size:12px;color:#1A1A1A;border-right:1px solid #E6E8EB}.seg span:last-child{border-right:0}.seg span.on{background:#1F1F1F;color:#fff;font-weight:600}.h2{font-size:19px;font-weight:600;margin:16px 0 11px}.pnl{background:#fff;border:1px solid #E6E8EB;border-radius:4px;padding:16px 18px}.dg{display:flex;gap:14px;margin:12px 0 14px}.dg .fl{margin:0}.dg .fl .lb{color:#1A1A1A}.dg .fl .dd{border:1px solid #E6E8EB;min-width:190px}</style>"
			VAR Menu =
			    "<div class='mn'><div class='lg'>LC</div>"
			    & "<div class='wm'><b>LOLA</b><i>casademunt</i></div>"
			    & "<label for='mt' class='bt'>" & UNICHAR ( 9776 ) & "</label>"
			    & "<div class='fls'>" & "<div class='fl'><div class='lb'>Temporada</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBISEASON[Code], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Desglose</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C1, DimensionesB2C1[DimensionesB2C1], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Top N</div><div class='dd'>" & FORMAT ( MAXX ( ParamTopN, ParamTopN[Top N] ), "#,0" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Orden</div><div class='dd'>" & CONCATENATEX ( OrdenSelector, OrdenSelector[Orden], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Categoria</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Categoria], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>GrupodeArt</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[GrupodeArt], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Familia agr.</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Descripcion_familia_agregada], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Subfamilia</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Subfamilia], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>TipoTienda</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBITIENDAS[TipoTienda], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Tienda</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBITIENDAS[NombreTienda], "Todas" ) & "</div></div>" & "</div></div>"
			VAR Cabecera =
			    "<div class='hd'><div><div class='h1'>Desempeño de ventas</div>"
			    & "<div class='sub'>" & [Rango y actualización] & "</div></div>"
			    & "<div class='ctl'><span class='lbl'>Visualizar datos hasta:</span>"
			    & "<span class='db'>" & FORMAT ( [FechaInicioPeriodoSeleccionado], "dd/MM/yyyy" ) & "</span>"
			    & "<span class='db'>" & FORMAT ( [FechaHastaSeleccionada], "dd/MM/yyyy" ) & "</span>"
			    & "<div class='seg'>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Año", "on", "" ) & "'>Año</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Trimestre", "on", "" ) & "'>Trimestre</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Mes", "on", "" ) & "'>Mes</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Semana", "on", "" ) & "'>Semana</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Día", "on", "" ) & "'>Día</span>" & "</div></div></div>"
			VAR Desgloses =
			    "<div class='dg'>" & "<div class='fl'><div class='lb'>Desglose principal</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C1, DimensionesB2C1[DimensionesB2C1], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Desglose secundario</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C2, DimensionesB2C2[DimensionesB2C2], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Categoría</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Categoria], "Todas" ) & "</div></div>" & "</div>"
			VAR Cuerpo =
			    & [HTML Tarjetas Desempeño]
			    & "<div class='pnl'><div class='h2' style='margin-top:0'>Desempeño por</div>"
			    & Desgloses & [HTML Tabla Desempeño] & "</div>"
			RETURN
			    Css & "<input type='checkbox' id='mt' class='tg'>"
			    & "<div class='pg'>" & Menu
			    & "<div class='ct'>" & Cabecera & Cuerpo & "</div></div>"
		displayFolder: 9 HTML
		lineageTag: 7ed6d878-bf86-48c3-b4d1-c7ebb2544aea

	/// Lo mismo para el catalogo, reutilizando [HTML Catalogo].
	measure 'HTML Página Catálogo' =
			VAR Css = "<style>*{margin:0;padding:0;box-sizing:border-box}.tg{display:none}.pg{position:relative;width:1280px;height:720px;background:#F2F3F5;font-family:Manrope,system-ui,-apple-system,sans-serif;color:#1A1A1A;overflow:hidden}.mn{position:absolute;left:0;top:0;bottom:0;width:62px;background:#6E2439;transition:width .18s ease;overflow:hidden;z-index:3}.tg:checked + .pg .mn{width:260px}.mn .lg{position:absolute;left:14px;top:14px;width:34px;height:34px;border-radius:50%;border:1.5px solid #fff;color:#fff;font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;letter-spacing:.02em}.mn .wm{position:absolute;left:60px;top:22px;color:#fff;font-size:15px;letter-spacing:.06em;white-space:nowrap;opacity:0;transition:opacity .18s}.tg:checked + .pg .mn .wm{opacity:1}.mn .wm b{font-weight:800}.mn .wm i{font-style:normal;font-weight:300}.bt{position:absolute;left:14px;top:62px;width:34px;height:30px;color:#fff;font-size:17px;cursor:pointer;display:flex;align-items:center;justify-content:center}.tg:checked + .pg .bt{left:auto;right:14px;top:18px}.fls{position:absolute;left:14px;right:14px;top:104px;opacity:0;pointer-events:none;transition:opacity .18s}.tg:checked + .pg .fls{opacity:1}.fl{margin-bottom:11px}.fl .lb{color:#DFA0C9;font-size:10.5px;font-weight:600;margin-bottom:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fl .dd{height:30px;line-height:30px;background:#fff;border-radius:6px;padding:0 26px 0 10px;font-size:12px;color:#1A1A1A;position:relative;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.fl .dd:after{content:'\25BE';position:absolute;right:9px;top:0;color:#6B6F76;font-size:10px}.ct{position:absolute;top:0;bottom:0;left:78px;right:0;padding:18px 22px;transition:left .18s ease;overflow:hidden}.tg:checked + .pg .ct{left:276px}.h1{font-size:26px;font-weight:700;letter-spacing:-.01em}.sub{font-size:11.5px;color:#6B6F76;margin-top:5px}.hd{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.ctl{display:flex;align-items:center;gap:10px;padding-top:4px}.ctl .lbl{font-size:11.5px;font-weight:600;color:#1A1A1A;white-space:nowrap}.db{height:30px;line-height:30px;background:#fff;border:1px solid #E6E8EB;border-radius:5px;padding:0 24px 0 10px;font-size:12px;position:relative;white-space:nowrap}.db:after{content:'\1F4C5';position:absolute;right:7px;top:0;font-size:11px;opacity:.6}.seg{display:flex;border:1px solid #E6E8EB;border-radius:5px;overflow:hidden;background:#fff}.seg span{padding:0 13px;height:28px;line-height:28px;font-size:12px;color:#1A1A1A;border-right:1px solid #E6E8EB}.seg span:last-child{border-right:0}.seg span.on{background:#1F1F1F;color:#fff;font-weight:600}.h2{font-size:19px;font-weight:600;margin:16px 0 11px}.pnl{background:#fff;border:1px solid #E6E8EB;border-radius:4px;padding:16px 18px}.dg{display:flex;gap:14px;margin:12px 0 14px}.dg .fl{margin:0}.dg .fl .lb{color:#1A1A1A}.dg .fl .dd{border:1px solid #E6E8EB;min-width:190px}</style>"
			VAR Menu =
			    "<div class='mn'><div class='lg'>LC</div>"
			    & "<div class='wm'><b>LOLA</b><i>casademunt</i></div>"
			    & "<label for='mt' class='bt'>" & UNICHAR ( 9776 ) & "</label>"
			    & "<div class='fls'>" & "<div class='fl'><div class='lb'>Temporada</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBISEASON[Code], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Desglose</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C1, DimensionesB2C1[DimensionesB2C1], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Top N</div><div class='dd'>" & FORMAT ( MAXX ( ParamTopN, ParamTopN[Top N] ), "#,0" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Orden</div><div class='dd'>" & CONCATENATEX ( OrdenSelector, OrdenSelector[Orden], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Categoria</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Categoria], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>GrupodeArt</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[GrupodeArt], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Familia agr.</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Descripcion_familia_agregada], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Subfamilia</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Subfamilia], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>TipoTienda</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBITIENDAS[TipoTienda], "Todas" ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Tienda</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBITIENDAS[NombreTienda], "Todas" ) & "</div></div>" & "</div></div>"
			VAR Cabecera =
			    "<div class='hd'><div><div class='h1'>Ranking de productos</div>"
			    & "<div class='sub'>" & [Rango y actualización] & "</div></div>"
			    & "<div class='ctl'><span class='lbl'>Visualizar datos hasta:</span>"
			    & "<span class='db'>" & FORMAT ( [FechaInicioPeriodoSeleccionado], "dd/MM/yyyy" ) & "</span>"
			    & "<span class='db'>" & FORMAT ( [FechaHastaSeleccionada], "dd/MM/yyyy" ) & "</span>"
			    & "<div class='seg'>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Año", "on", "" ) & "'>Año</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Trimestre", "on", "" ) & "'>Trimestre</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Mes", "on", "" ) & "'>Mes</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Semana", "on", "" ) & "'>Semana</span>" & "<span class='" & IF ( [PeriodoSeleccionado] = "Día", "on", "" ) & "'>Día</span>" & "</div></div></div>"
			VAR Desgloses =
			    "<div class='dg'>" & "<div class='fl'><div class='lb'>Desglose principal</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C1, DimensionesB2C1[DimensionesB2C1], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Desglose secundario</div><div class='dd'>" & CONCATENATEX ( DimensionesB2C2, DimensionesB2C2[DimensionesB2C2], ", " ) & "</div></div>" &
			    "<div class='fl'><div class='lb'>Categoría</div><div class='dd'>" & SELECTEDVALUE ( LOL_PBIMODELITEM[Categoria], "Todas" ) & "</div></div>" & "</div>"
			VAR Cuerpo =
			    "<div class='h2'>Catálogo</div>"
			    & "<div class='pnl'>" & Desgloses & [HTML Catálogo] & "</div>"
			RETURN
			    Css & "<input type='checkbox' id='mt' class='tg'>"
			    & "<div class='pg'>" & Menu
			    & "<div class='ct'>" & Cabecera & Cuerpo & "</div></div>"
		displayFolder: 9 HTML
		lineageTag: bb3e6b0a-de03-4b3f-b0ea-91711bf64d21

	/// El panel del menu con sus 10 etiquetas, colocadas sobre la
	/// geometria real de cada segmentador. Los segmentadores llevan la
	/// cabecera apagada: es lo unico que deja redondear su contenedor.
	measure 'HTML Menu Desempeño' =
			"<style>.mn{position:relative;width:100%;height:720px;background:#6E2439;font-family:Manrope,system-ui,-apple-system,sans-serif}.mn .lb{position:absolute;color:#DFA0C9;font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mn .rl{position:absolute;top:0;right:0;width:1px;height:100%;background:rgba(255,255,255,.14)}</style>"
			    & "<div class='mn'><div class='rl'></div><div class='lb' style='left:131.8px;top:270.6px;width:114px'>GrupodeArt</div><div class='lb' style='left:13.8px;top:78.6px;width:232px'>Ventas por</div><div class='lb' style='left:13.8px;top:206.6px;width:232px'>Orden</div><div class='lb' style='left:13.8px;top:526.6px;width:232px'>Tienda</div><div class='lb' style='left:131.8px;top:334.6px;width:114px'>Subfamilia</div><div class='lb' style='left:13.8px;top:270.6px;width:112px'>Categoria</div><div class='lb' style='left:13.8px;top:334.6px;width:112px'>Familia agr.</div><div class='lb' style='left:13.8px;top:142.6px;width:232px'>Top N</div><div class='lb' style='left:13.8px;top:462.6px;width:232px'>TipoTienda</div><div class='lb' style='left:13.8px;top:398.6px;width:232px'>Modelo-Color</div></div>"
		displayFolder: 9 HTML
		lineageTag: f90a572a-7644-423e-9f84-599363854cf6

	/// El panel del menu con sus 9 etiquetas, colocadas sobre la
	/// geometria real de cada segmentador. Los segmentadores llevan la
	/// cabecera apagada: es lo unico que deja redondear su contenedor.
	measure 'HTML Menu Catálogo' =
			"<style>.mn{position:relative;width:100%;height:720px;background:#6E2439;font-family:Manrope,system-ui,-apple-system,sans-serif}.mn .lb{position:absolute;color:#DFA0C9;font-size:10.5px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mn .rl{position:absolute;top:0;right:0;width:1px;height:100%;background:rgba(255,255,255,.14)}</style>"
			    & "<div class='mn'><div class='rl'></div><div class='lb' style='left:13.8px;top:270.6px;width:112px'>Familia agr.</div><div class='lb' style='left:13.8px;top:462.6px;width:232px'>Tienda</div><div class='lb' style='left:13.8px;top:142.6px;width:232px'>Orden</div><div class='lb' style='left:131.8px;top:270.6px;width:114px'>Subfamilia</div><div class='lb' style='left:13.8px;top:398.6px;width:232px'>TipoTienda</div><div class='lb' style='left:131.8px;top:206.6px;width:114px'>GrupodeArt</div><div class='lb' style='left:13.8px;top:206.6px;width:112px'>Categoria</div><div class='lb' style='left:13.8px;top:78.6px;width:232px'>Top N</div><div class='lb' style='left:13.8px;top:334.6px;width:232px'>Modelo-Color</div></div>"
		displayFolder: 9 HTML
		lineageTag: e63ac57a-ed2a-4a46-ad8a-36616b62a8e4

	/// Las 17 celdas de valores de una fila, en el contexto que toque.
	measure 'HTML Fila Desempeño' =
			VAR x1 = [Share_Pct]
			VAR c1 = IF ( ISBLANK ( x1 ),
			    "<span class='c x1 z'>—</span>",
			    "<span class='c x1 g'>" & FORMAT ( x1, "0%" ) & "</span>" )
			VAR x2 = [Ventas_YTD]
			VAR c2 = IF ( ISBLANK ( x2 ),
			    "<span class='c x2 z'>—</span>",
			    "<span class='c x2 b vn'>" & FORMAT ( x2, "€ #,0" ) & "</span>" )
			VAR x3 = [Objetivos_YTD]
			VAR c3 = IF ( ISBLANK ( x3 ),
			    "<span class='c x3 z'>—</span>",
			    "<span class='c x3 g'>" & FORMAT ( x3, "€ #,0" ) & "</span>" )
			VAR x4 = [EvolucionObjetivo_%]
			VAR c4 = IF ( ISBLANK ( x4 ),
			    "<span class='c x4 z'>—</span>",
			    "<span class='c x4 " & IF ( x4 < 0, "m", "p" ) & "'>" & FORMAT ( x4, "+0.00%;-0.00%;0.00%" ) & "</span>" )
			VAR x5 = [Ventas_YTD_LY]
			VAR c5 = IF ( ISBLANK ( x5 ),
			    "<span class='c x5 z'>—</span>",
			    "<span class='c x5 g'>" & FORMAT ( x5, "€ #,0" ) & "</span>" )
			VAR x6 = [Ventas_YTD_Var_%]
			VAR c6 = IF ( ISBLANK ( x6 ),
			    "<span class='c x6 z'>—</span>",
			    "<span class='c x6 " & IF ( x6 < 0, "m", "p" ) & "'>" & FORMAT ( x6, "+0.00%;-0.00%;0.00%" ) & "</span>" )
			VAR x7 = [Tasa_Devolucion_YTD]
			VAR c7 = IF ( ISBLANK ( x7 ),
			    "<span class='c x7 z'>—</span>",
			    "<span class='c x7 g'>" & FORMAT ( x7, "0.0%" ) & "</span>" )
			VAR x8 = [Tasa_Devolucion_YTD_Var]
			VAR c8 = IF ( ISBLANK ( x8 ),
			    "<span class='c x8 z'>—</span>",
			    "<span class='c x8 " & IF ( x8 < 0, "m", "p" ) & "'>" & FORMAT ( x8, "+0.0""p"";-0.0""p"";0.0""p""" ) & "</span>" )
			VAR x9 = [NumeroTransacciones_YTD]
			VAR c9 = IF ( ISBLANK ( x9 ),
			    "<span class='c x9 z'>—</span>",
			    "<span class='c x9 '>" & FORMAT ( x9, "#,0" ) & "</span>" )
			VAR x10 = [NumeroTransacciones_Var_%]
			VAR c10 = IF ( ISBLANK ( x10 ),
			    "<span class='c x10 z'>—</span>",
			    "<span class='c x10 " & IF ( x10 < 0, "m", "p" ) & "'>" & FORMAT ( x10, "+0.00%;-0.00%;0.00%" ) & "</span>" )
			VAR x11 = [PromedioVentaTransaccion_YTD]
			VAR c11 = IF ( ISBLANK ( x11 ),
			    "<span class='c x11 z'>—</span>",
			    "<span class='c x11 '>" & FORMAT ( x11, "€ #,##0.00" ) & "</span>" )
			VAR x12 = [PromedioVentaTransaccion_Var_%]
			VAR c12 = IF ( ISBLANK ( x12 ),
			    "<span class='c x12 z'>—</span>",
			    "<span class='c x12 " & IF ( x12 < 0, "m", "p" ) & "'>" & FORMAT ( x12, "+0.00%;-0.00%;0.00%" ) & "</span>" )
			VAR x13 = [UPT_YTD]
			VAR c13 = IF ( ISBLANK ( x13 ),
			    "<span class='c x13 z'>—</span>",
			    "<span class='c x13 '>" & FORMAT ( x13, "#,##0.0" ) & "</span>" )
			VAR x14 = [UPT_Var_%]
			VAR c14 = IF ( ISBLANK ( x14 ),
			    "<span class='c x14 z'>—</span>",
			    "<span class='c x14 " & IF ( x14 < 0, "m", "p" ) & "'>" & FORMAT ( x14, "+0.00%;-0.00%;0.00%" ) & "</span>" )
			VAR x15 = [Entradas_YTD]
			VAR c15 = IF ( ISBLANK ( x15 ),
