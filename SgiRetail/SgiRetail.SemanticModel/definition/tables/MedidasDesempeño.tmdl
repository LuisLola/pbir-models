			RETURN DIVIDE(A - L, L)
		formatString: +0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000006

	measure TM_Evol_Anio =
			VAR FH = [FechaHastaSeleccionada]
			VAR FI = DATE(YEAR(FH), 1, 1)
			VAR FHLY = FH - 364
			VAR FILY = DATE(YEAR(FHLY), 1, 1)
			VAR VA = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR TA = CALCULATE([NumeroTransacciones], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR VL = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			VAR TL = CALCULATE([NumeroTransacciones], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			RETURN DIVIDE(DIVIDE(VA, TA) - DIVIDE(VL, TL), DIVIDE(VL, TL))
		formatString: +0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000007

