table MedidasDesempeño
	lineageTag: c1d2e3f4-a5b6-7890-cdef-012345678901

	measure Share_Pct =
			VAR TotalGlobal =
				CALCULATE(
					[Ventas_YTD],
					ALLSELECTED(LOL_PBITIENDAS[TipoTienda]),
					ALLSELECTED(LOL_PBITIENDAS[NombreTienda]),
					ALLSELECTED(LOL_PBIMODELITEM[Categoria]),
					ALLSELECTED(LOL_PBIMODELITEM[Descripcion_familia_agregada])
				)
			RETURN DIVIDE([Ventas_YTD], TotalGlobal)
		formatString: 0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000001

	measure Share_Bar = MIN(1, [Share_Pct])
		formatString: 0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000002

	measure VN_Evol_Anio =
			VAR FH = [FechaHastaSeleccionada]
			VAR FI = DATE(YEAR(FH), 1, 1)
			VAR FHLY = FH - 364
			VAR FILY = DATE(YEAR(FHLY), 1, 1)
			VAR A = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR L = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			RETURN DIVIDE(A - L, L)
		formatString: +0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000003

	measure VN_Evol_Mes =
			VAR FH = [FechaHastaSeleccionada]
			VAR FI = DATE(YEAR(FH), MONTH(FH), 1)
			VAR FHLY = FH - 364
			VAR FILY = DATE(YEAR(FHLY), MONTH(FHLY), 1)
			VAR A = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR L = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			RETURN DIVIDE(A - L, L)
		formatString: +0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000004

	measure VN_Evol_Sem =
			VAR FH = [FechaHastaSeleccionada]
			VAR FI = FH - WEEKDAY(FH, 2) + 1
			VAR FHLY = FH - 364
			VAR FILY = FHLY - WEEKDAY(FHLY, 2) + 1
			VAR A = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FI, FH))
			VAR L = CALCULATE([Ventas], DATESBETWEEN(Calendario[Date], FILY, FHLY))
			RETURN DIVIDE(A - L, L)
		formatString: +0%;-0%;0%
		lineageTag: c1d2e3f4-a5b6-7890-cdef-010000000005

	measure VN_Evol_Dia =
			VAR FH = [FechaHastaSeleccionada]
