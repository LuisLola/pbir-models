// ============================================================================
// Medidas DAX – Panel móvil Lola Casademunt
// ============================================================================
// Copia cada bloque en Power BI Desktop:
//   Modeling tab → New measure → pega → Enter
// ----------------------------------------------------------------------------
// Asume estas tablas/columnas. Cambia los nombres a los reales de tu modelo:
//   FactVentas[Ventas]            -> ventas netas con IVA
//   FactVentas[Objetivo]          -> objetivo de ventas
//   FactVentas[VentasPY]          -> ventas mismo periodo año anterior
//   FactVentas[Unidades]          -> nº de unidades
//   FactVentas[NumVentas]         -> nº de tickets / ventas
//   FactVentas[Entradas]          -> tráfico (sólo Tienda)
//   FactVentas[TraficoExterior]   -> tráfico exterior (sólo Tienda)
//   DimCanal[Canal]               -> Tienda | Corner ECI | Online | Marketplaces
//   DimTienda[Tienda]             -> nombre de tienda
//   DimFecha[Fecha]               -> tabla calendario
// ============================================================================


// ---------- KPIs base ----------

Venta Neta =
SUM ( FactVentas[Ventas] )

Objetivo =
SUM ( FactVentas[Objetivo] )

Venta PY =
CALCULATE (
    SUM ( FactVentas[Ventas] ),
    SAMEPERIODLASTYEAR ( DimFecha[Fecha] )
)

Num Ventas =
SUM ( FactVentas[NumVentas] )

Unidades =
SUM ( FactVentas[Unidades] )

Ticket Medio =
DIVIDE ( [Venta Neta], [Num Ventas] )

UPT =
DIVIDE ( [Unidades], [Num Ventas] )

% Conversion =
DIVIDE ( [Num Ventas], SUM ( FactVentas[Entradas] ) )

% Atraccion =
DIVIDE ( SUM ( FactVentas[Entradas] ), SUM ( FactVentas[TraficoExterior] ) )


// ---------- Comparativas ----------

% vs Objetivo =
DIVIDE ( [Venta Neta] - [Objetivo], [Objetivo] )

% Completado Obj =
DIVIDE ( [Venta Neta], [Objetivo] )

% vs PY =
DIVIDE ( [Venta Neta] - [Venta PY], [Venta PY] )


// ---------- Semáforo (color condicional) ----------
// Estas dos medidas devuelven el HEX a usar en:
//   Format → Data colors → Conditional formatting → Field value
//
// Reglas:
//   pct >= 0%   -> verde   (#1F8A5B)
//   -10% <= pct < 0   -> amarillo (#B57A0E)
//   pct < -10%  -> rojo    (#C73838)

Color vs Obj =
VAR pct = [% vs Objetivo]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( pct ),  "#8089A2",
        pct >= 0,          "#1F8A5B",
        pct >= -0.10,      "#B57A0E",
        "#C73838"
    )

Color vs PY =
VAR pct = [% vs PY]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( pct ),  "#8089A2",
        pct >= 0,          "#1F8A5B",
        pct >= -0.10,      "#B57A0E",
        "#C73838"
    )

// Fondos pastel (para Background condicional de la Card pequeña)

Bg vs Obj =
VAR pct = [% vs Objetivo]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( pct ),  "#F7F6F2",
        pct >= 0,          "#E3F4EB",
        pct >= -0.10,      "#FAF1DD",
        "#FBE6E6"
    )

Bg vs PY =
VAR pct = [% vs PY]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( pct ),  "#F7F6F2",
        pct >= 0,          "#E3F4EB",
        pct >= -0.10,      "#FAF1DD",
        "#FBE6E6"
    )


// ---------- Etiquetas con formato listas para mostrar ----------

Texto vs Obj =
VAR pct = [% vs Objetivo]
RETURN
    IF (
        ISBLANK ( pct ),
        "— vs OBJ",
        FORMAT ( pct, "+0%;-0%;0%" ) & " vs OBJ"
    )

Texto vs PY =
VAR pct = [% vs PY]
RETURN
    IF (
        ISBLANK ( pct ),
        "— vs PY",
        FORMAT ( pct, "+0%;-0%;0%" ) & " vs PY"
    )

Texto Completado =
VAR p = [% Completado Obj]
RETURN
    "vs Objetivo · " & FORMAT ( p, "0%" ) & " completado"

Texto Objetivo Formato =
"OBJ € " & FORMAT ( [Objetivo], "#.##0" )


// ---------- Ancho de barra de progreso (técnica) ----------
// Si no usas un Bar chart sino dos Shape rectángulos superpuestos:
//   - El de fondo siempre 100% del ancho del contenedor.
//   - El de relleno: ancho = [% Bar Width] * ancho contenedor.
// Se ajusta a mano en el formato del rectángulo, pero esta medida
// te dice el porcentaje exacto a aplicar.

% Bar Width =
MIN ( 1, [% Completado Obj] )
