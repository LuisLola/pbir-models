{
  "name": "Lola Casademunt – Mobile Dashboard (Conservadora)",
  "dataColors": [
    "#E11A6F",
    "#10182F",
    "#1F8A5B",
    "#B57A0E",
    "#C73838",
    "#8089A2",
    "#FBE6EF",
    "#1B2546"
  ],
  "background": "#FFFFFF",
  "foreground": "#0A0F1E",
  "tableAccent": "#E11A6F",
  "good": "#1F8A5B",
  "neutral": "#B57A0E",
  "bad": "#C73838",
  "maximum": "#1F8A5B",
  "center": "#B57A0E",
  "minimum": "#C73838",
  "null": "#8089A2",

  "textClasses": {
    "title":      { "fontFace": "Segoe UI", "fontSize": 22, "color": "#0A0F1E" },
    "header":     { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#0A0F1E" },
    "label":      { "fontFace": "Segoe UI", "fontSize": 10, "color": "#8089A2" },
    "callout":    { "fontFace": "Segoe UI Bold", "fontSize": 42, "color": "#0A0F1E" }
  },

  "visualStyles": {
    "*": {
      "*": {
        "background": [
          { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }
        ],
        "border": [
          { "show": false }
        ],
        "title": [
          { "show": false }
        ],
        "visualHeader": [
          { "show": false }
        ]
      }
    },
    "card": {
      "*": {
        "background":   [ { "show": false } ],
        "border":       [ { "show": false } ],
        "title":        [ { "show": false } ],
        "categoryAxis": [ { "show": false } ],
        "labels": [
          {
            "color":            { "solid": { "color": "#0A0F1E" } },
            "fontSize":         32,
            "fontFamily":       "Segoe UI Bold",
            "labelPrecision":   0,
            "labelDisplayUnits": 0
          }
        ],
        "categoryLabels": [
          {
            "color":      { "solid": { "color": "#8089A2" } },
            "fontSize":   10,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } } } ],
        "border":     [ { "show": true, "color": { "solid": { "color": "#E4E7F0" } }, "radius": 10 } ],
        "dataLabels": [
          { "color": { "solid": { "color": "#0A0F1E" } }, "fontSize": 22, "fontFamily": "Segoe UI Bold" }
        ],
        "categoryLabels": [
          { "color": { "solid": { "color": "#8089A2" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical":         false,
            "gridHorizontal":       true,
            "gridHorizontalColor":  { "solid": { "color": "#E4E7F0" } },
            "outlineColor":         { "solid": { "color": "#E4E7F0" } },
            "outlineWeight":        1
          }
        ],
        "columnHeaders": [
          {
            "fontColor":  { "solid": { "color": "#8089A2" } },
            "fontFamily": "Segoe UI Semibold",
            "fontSize":   10,
            "background": { "solid": { "color": "#F7F6F2" } }
          }
        ],
        "values": [
          {
            "fontColor":    { "solid": { "color": "#0A0F1E" } },
            "fontFamily":   "Segoe UI",
            "fontSize":     11,
            "backColorPrimary": { "solid": { "color": "#FFFFFF" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background":   [ { "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "outspace":     [ { "color": { "solid": { "color": "#F4F1EA" } } } ]
      }
    }
  }
}
