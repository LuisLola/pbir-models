table _Medidas
	lineageTag: a4372108-500a-4b03-83f2-5f0b3f0497c9

	/// Pedidos de compra distintos.
	measure 'Pedidos de compra' = DISTINCTCOUNT ( LOL_PBIPURCHASEORDERS[DocumentInternalKey] )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 97709a3c-1cd5-487a-a722-2b0f7cb06620

	/// Lineas de pedido de compra.
	measure 'Líneas de compra' = COUNTROWS ( LOL_PBIPURCHASEORDERS )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 6b538c0c-5b03-4fc0-9827-657f3968fb65

	/// Pedidos con alguna linea abierta.
	measure 'Pedidos abiertos' = CALCULATE ( [Pedidos de compra], LOL_PBIPURCHASEORDERS[Estado] = "Abierto" )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 6c7dbcce-f331-4e7a-988b-9d0e34dbb694

	/// Proveedores distintos con pedido.
	measure 'Proveedores' = DISTINCTCOUNT ( LOL_PBIPURCHASEORDERS[CardCode] )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: f7212986-13e2-48c6-8d89-91524b822ee8

	/// Referencias distintas.
	measure 'Referencias' = DISTINCTCOUNT ( LOL_PBIMODELITEM[Referencia-Modelo] )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: f21bad0d-e95d-44dd-a069-227813af7f2e

	/// Unidades. Ojo: Qty vive en LOL_PBIB2BSALESORDER, no en compras.
	measure 'Unidades' = SUM ( LOL_PBIB2BSALESORDER[Qty] )
		formatString: #,0
		displayFolder: 1 Volumen
		lineageTag: 7675c668-0568-4d75-8310-6071eefcece1

	measure 'Chip Categoria' = VAR n = COUNTROWS ( VALUES ( LOL_PBIMODELITEM[Categoria] ) ) VAR txt = IF ( n = 1, SELECTEDVALUE ( LOL_PBIMODELITEM[Categoria] ), n & " sel." ) RETURN IF ( ISFILTERED ( LOL_PBIMODELITEM[Categoria] ), txt & "  ✕" )
		displayFolder: 0 Pildoras
		lineageTag: 85e07071-c8c8-4dab-8248-8857017e8f4a

	measure 'Chip Categoria Color' = IF ( ISFILTERED ( LOL_PBIMODELITEM[Categoria] ), "#DFA0C9", "#6F263D" )
		displayFolder: 0 Pildoras
		lineageTag: f4b6c8ce-4c4e-4417-917e-8aa1480313c8

