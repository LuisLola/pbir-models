table LOL_PBIPACKAGES
	lineageTag: 541e8d00-7678-45de-8004-2075ac2abc94

	/// Los embalajes del flujo de COMPRAS: una fila por caja x articulo,
	/// con la cadena documental pivotada (entrada, solicitud de traslado,
	/// traslado) y el pedido de compra resuelto por SKU dentro de la entrada.
	/// Acotado a Flujo = Compras en el SQL: la vista completa son 3,3 M de
	/// filas y el flujo de compras son 730.
	/// PROVISIONAL: lee directo de HANA. Cuando la vista este en el ETL,
	/// cambiar solo el bloque source.
	/// La caja. DISTINCTCOUNT sobre esto cuenta bultos sin duplicar.
	column PackCode
		dataType: string
		lineageTag: 3f46bb05-424f-4b5a-a8e4-80d8cd0fb15e
		summarizeBy: none
		sourceColumn: PackCode

		annotation SummarizationSetBy = Automatic

	/// Codigo SSCC de la etiqueta.
	column SSCC
		dataType: string
		lineageTag: d5653d4f-34bb-4a9d-8026-a8cc53aa21cf
		summarizeBy: none
		sourceColumn: SSCC

		annotation SummarizationSetBy = Automatic

	/// Numero de caja dentro del envio.
	column NumCaja
		dataType: int64
		lineageTag: 2175f75c-0765-49d0-a91b-263d713eeb13
		summarizeBy: none
		sourceColumn: NumCaja

		annotation SummarizationSetBy = Automatic

	/// Tipo de embalaje.
	column TipoEmbalaje
		dataType: string
		lineageTag: ddbc43ab-2fb6-46a6-bb76-955738886dec
		summarizeBy: none
		sourceColumn: TipoEmbalaje

		annotation SummarizationSetBy = Automatic

	/// Peso de la caja. OJO: se repite en cada linea de contenido.
	column PesoCaja
		dataType: double
		lineageTag: c244cd37-b050-4288-8a94-8fe6bbd12b90
		summarizeBy: sum
		sourceColumn: PesoCaja

		annotation SummarizationSetBy = Automatic

	/// Nivel en el arbol de embalaje.
	column NivelEmbalaje
		dataType: int64
		lineageTag: 6c4b9a56-0476-49a8-a052-2c622bc9a3ef
		summarizeBy: none
		sourceColumn: NivelEmbalaje

		annotation SummarizationSetBy = Automatic

	/// Si es una caja dentro de otra.
	column EsSubCaja
		dataType: string
		lineageTag: b1909e3f-08e4-48f1-a209-5eaee713aefb
		summarizeBy: none
		sourceColumn: EsSubCaja

		annotation SummarizationSetBy = Automatic

