				    Origen = Sql.Database("192.168.0.232", "hana_etl_admin"),
				    dbo_LOL_PBIB2BSALESORDER = Origen{[Schema="dbo",Item="LOL_PBIB2BSALESORDER"]}[Data]
				in
				    dbo_LOL_PBIB2BSALESORDER

