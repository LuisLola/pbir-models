	/// Clave de linea de pedido. Las incidencias comparten (DocEntry, LineNum)
	/// entre ellas, por eso llevan sufijo: sin el, la relacion no se puede crear.
	column KLinea = LOL_PBIB2BSALESORDER[DocEntry] & "-" & LOL_PBIB2BSALESORDER[LineNum] & IF ( LOL_PBIB2BSALESORDER[IsIncidence] = "Y", "-INC-" & LOL_PBIB2BSALESORDER[ItemCode], "" )
		lineageTag: fe6225d1-38d3-4623-a451-f8ba396ed57e
		summarizeBy: none

	/// Picking al que va la linea. En blanco si no tiene o si es incidencia.
	column Picking = VAR p = TRIM ( LOL_PBIB2BSALESORDER[PickIdNo] ) RETURN IF ( LOL_PBIB2BSALESORDER[IsIncidence] = "N" && LEN ( p ) > 0 && p <> "0", p )
		lineageTag: ab41d61b-3422-44a0-bbed-eade2122f823
		summarizeBy: none

	/// Qty llega como texto desde el ETL; esta es su version numerica.
	column 'Cantidad pedida' = VAR q = TRIM ( LOL_PBIB2BSALESORDER[Qty] ) RETURN IF ( LEN ( q ) > 0, VALUE ( q ) )
		formatString: #,0
		lineageTag: 7c99e158-f630-425c-a447-684ea7e2b061
		summarizeBy: sum

	/// OpenQty llega como texto desde el ETL; esta es su version numerica.
	column 'Cantidad pendiente' = VAR q = TRIM ( LOL_PBIB2BSALESORDER[OpenQty] ) RETURN IF ( LEN ( q ) > 0, VALUE ( q ) )
		formatString: #,0
		lineageTag: 33435a35-cb58-4d06-80d1-38b212c2250d
		summarizeBy: sum

	partition LOL_PBIB2BSALESORDER = m
		mode: import
		source =
