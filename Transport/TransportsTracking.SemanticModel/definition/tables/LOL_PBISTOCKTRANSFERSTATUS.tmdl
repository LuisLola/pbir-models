	/// FechaEstadologistico llega como texto ISO; esta es su version fecha.
	column FechaEstado = VAR x = TRIM ( LOL_PBISTOCKTRANSFERSTATUS[FechaEstadologistico] ) RETURN IF ( LEN ( x ) >= 10, DATE ( VALUE ( MID ( x, 1, 4 ) ), VALUE ( MID ( x, 6, 2 ) ), VALUE ( MID ( x, 9, 2 ) ) ) )
		formatString: dd/mm/yyyy
		lineageTag: e64e8a3a-3e96-4e9a-8630-ade8fc7d15df
		summarizeBy: none

		variation Variación
			isDefault
			relationship: 6f90b445-2b00-4eb3-8df5-2daa62a702b4
			defaultHierarchy: LocalDateTable_be561ec9-67ca-4c10-b91a-26c43aa3f18e.'Jerarquía de fechas'

	/// Dias laborables que lleva la linea en su estado actual.
	column 'Días en estado' = VAR f = LOL_PBISTOCKTRANSFERSTATUS[FechaEstado] RETURN IF ( NOT ISBLANK ( f ), NETWORKDAYS ( f, TODAY (), 1, VALUES ( Festivos[Fecha] ) ) )
		formatString: #,0
		lineageTag: 4dbf7f30-6e42-4caf-b9c2-e1a67166fa0c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Ciclo real de inbound en dias laborables. Es el unico tramo entre dos
	/// hitos ocurridos: el resto de fechas de la tabla son previsiones.
	column 'Días embarque a disponible' = VAR a = LOL_PBISTOCKTRANSFERSTATUS[FechaEmbarque] VAR b = LOL_PBISTOCKTRANSFERSTATUS[FechaDisponibilidad] RETURN IF ( NOT ISBLANK ( a ) && NOT ISBLANK ( b ) && b >= a, NETWORKDAYS ( a, b, 1, VALUES ( Festivos[Fecha] ) ) )
		formatString: #,0
		lineageTag: 70d953e6-939b-4883-8ed4-f761815ae17a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Dias naturales de retraso (+) o adelanto (-) respecto a la delivery prevista.
	column 'Desvío vs previsto' = VAR p = LOL_PBISTOCKTRANSFERSTATUS[FechaDeliveryActualizada] VAR r = LOL_PBISTOCKTRANSFERSTATUS[FechaDisponibilidad] RETURN IF ( NOT ISBLANK ( p ) && NOT ISBLANK ( r ), DATEDIFF ( p, r, DAY ) )
		formatString: #,0;-#,0;0
		lineageTag: a56ad342-6d6b-4f5d-a4f5-c0cc0ef6a900
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

