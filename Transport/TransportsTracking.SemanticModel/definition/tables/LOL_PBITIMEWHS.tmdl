	column SLA_Objetivo
		dataType: string
		lineageTag: 68e75d9f-4185-4aab-b228-9e4b20e83231
		summarizeBy: none
		sourceColumn: SLA_Objetivo

		annotation SummarizationSetBy = Automatic

	/// Horas desde la fecha de picking hasta el registro 20.
	column 'Horas Pick a Log20' = IF ( NOT ISBLANK ( LOL_PBITIMEWHS[PickDate] ) && NOT ISBLANK ( LOL_PBITIMEWHS[FechaLog20] ), DATEDIFF ( LOL_PBITIMEWHS[PickDate], LOL_PBITIMEWHS[FechaLog20], MINUTE ) / 60.0 )
		formatString: #,0.0
		lineageTag: a102e3e3-612f-4d33-bfff-6021354c0cc5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Horas del tramo 20-40, el largo (media 39,8 h).
	column 'Horas Log20 a Log40' = IF ( NOT ISBLANK ( LOL_PBITIMEWHS[FechaLog20] ) && NOT ISBLANK ( LOL_PBITIMEWHS[FechaLog40] ), DATEDIFF ( LOL_PBITIMEWHS[FechaLog20], LOL_PBITIMEWHS[FechaLog40], MINUTE ) / 60.0 )
		formatString: #,0.0
		lineageTag: ddcf7fcc-bc33-488c-bc5c-d0a210455e45
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Horas del tramo 40-60 (media 20,5 h).
	column 'Horas Log40 a Log60' = IF ( NOT ISBLANK ( LOL_PBITIMEWHS[FechaLog40] ) && NOT ISBLANK ( LOL_PBITIMEWHS[FechaLog60] ), DATEDIFF ( LOL_PBITIMEWHS[FechaLog40], LOL_PBITIMEWHS[FechaLog60], MINUTE ) / 60.0 )
		formatString: #,0.0
		lineageTag: 6e2bdb79-cf48-4571-8baa-ed24abf7c954
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// El original DiasHabiles_20_40 llega como texto; esta es su version numerica.
	column 'Dias habiles 20-40' = VAR t = TRIM ( LOL_PBITIMEWHS[DiasHabiles_20_40] ) RETURN IF ( NOT ISBLANK ( t ) && t <> "", VALUE ( t ) )
		formatString: #,0.00
		lineageTag: 280d753b-2f92-423e-acd9-66b86b6da28e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

