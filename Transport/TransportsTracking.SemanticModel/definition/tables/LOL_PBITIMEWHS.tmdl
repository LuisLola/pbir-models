	column Estado
		dataType: string
		lineageTag: a156c505-becf-473e-90c9-a046c2f633a8
		summarizeBy: none
		sourceColumn: Estado

		annotation SummarizationSetBy = Automatic

	/// El interruptor: Si salio del almacen, No se quedo dentro.
	/// Un picking sin numero de expedicion no se ha expedido.
	column Expedido = IF ( LEN ( TRIM ( LOL_PBITIMEWHS[Expedicion_Picking] ) ) > 0, "Sí", "No" )
		lineageTag: b861de74-99c7-43df-bc0d-b4b34d129e1e
		summarizeBy: none

	/// Por que no salio. En blanco si si salio.
	/// Anulado = estado R: entro pero nunca se preparo.
	column 'Motivo sin expedir' = IF ( LEN ( TRIM ( LOL_PBITIMEWHS[Expedicion_Picking] ) ) > 0, BLANK (), IF ( CONTAINSSTRING ( LOL_PBITIMEWHS[Comentarios], "cerrado manualmente" ), "Cerrado manualmente", IF ( LOL_PBITIMEWHS[Estado] = "R", "Anulado", "Sin expedición" ) ) )
		lineageTag: a65de00b-44a3-4254-8c0c-dca61a19f2c7
		summarizeBy: none

	partition LOL_PBITIMEWHS = m
		mode: import
		source =
				let
				    Origen = Sql.Database("192.168.0.232", "hana_etl_admin"),
				    dbo_LOL_PBITIMEWHS = Origen{[Schema="dbo",Item="LOL_PBITIMEWHS"]}[Data]
				in
