	/// Linea de pedido de la que nace el albaran. BaseType 17 = pedido de venta;
	/// el resto son entregas sin pedido detras y quedan en blanco.
	column KPedido = IF ( LOL_PBISALESDELIVERY[BaseType] = "17" && LEN ( TRIM ( LOL_PBISALESDELIVERY[BaseEntry] ) ) > 0, LOL_PBISALESDELIVERY[BaseEntry] & "-" & LOL_PBISALESDELIVERY[BaseLine] )
		lineageTag: 3973fdb1-f938-4323-85d5-8006a2b6ac00
		summarizeBy: none

