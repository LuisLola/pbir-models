	partition Calendario = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2025, 1, 1), DATE(2025, 12, 31)),
				    "Año", YEAR([Date]),
				    "AñoTexto", FORMAT([Date], "0000"),
				    "NombreMesAño", FORMAT([Date], "MMM YYYY"),
				    "Semana", WEEKNUM([Date], 2),
				    "NombreSemana", "Semana " & WEEKNUM([Date], 2) & " " & YEAR([Date]),
				    "NombreDía", FORMAT([Date], "DD MMMM YYYY"),
				    "DíaMes", DAY([Date]),
				    "Mes", MONTH([Date])
				)
				
				```

	annotation PBI_Id = 1dc876e9f79143cb9b9d096f47a2e617

