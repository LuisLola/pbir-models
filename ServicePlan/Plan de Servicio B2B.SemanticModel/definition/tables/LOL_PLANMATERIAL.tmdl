table LOL_PLANMATERIAL
	lineageTag: c68ab331-40ba-4a50-ac57-02486bdc4ce8

	measure 'Fecha Servicio 1º Quincena' = ```
			
			VAR RangoIni = MIN ( 'RangoDisponibilidad'[Fecha] )
			VAR RangoFin = MAX ( 'RangoDisponibilidad'[Fecha] )
			VAR TotalPendiente = SUM ( 'LOL_PLANMATERIAL'[Unidades pendientes Entregar] )
			VAR TotalCubierto =
			    SUMX (
			        'LOL_PLANMATERIAL',
			        VAR FechaFin = 'LOL_PLANMATERIAL'[Fecha Fin pedido venta]
			        VAR FechaDisp = 'LOL_PLANMATERIAL'[Fecha disponibilidad (línea del articulo)]
			        VAR EnAlmacen = 'LOL_PLANMATERIAL'[Uniades en Piciking] + 'LOL_PLANMATERIAL'[Unidades asignadas]
			        VAR EnTransito = 'LOL_PLANMATERIAL'[Unidades asignadas Transito]
			        RETURN
			            EnAlmacen
			                + IF (
			                NOT ISBLANK ( FechaDisp )
			                    && FechaDisp >= RangoIni
			                    && FechaDisp <= RangoFin
			                    && NOT ISBLANK ( FechaFin )
			                    && FechaDisp <= FechaFin - 4,
			                EnTransito,
			                0
			            )
			    )
			RETURN
			    IF ( TotalPendiente > 0, DIVIDE ( TotalCubierto, TotalPendiente ), BLANK () )
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: 4a7d358c-6d91-48b9-8eed-0bb0687d33c6

	measure '% Cartera Cubierta Temporada?' = ```
			
			VAR OpenQty = SUM('LOL_PLANMATERIAL'[Unidades pendientes Entregar])
			VAR SumaCubierta =
			    SUM('LOL_PLANMATERIAL'[Uniades en Piciking]) +
			    SUM('LOL_PLANMATERIAL'[Unidades asignadas]) +
			    SUM('LOL_PLANMATERIAL'[Unidades asignadas Transito])
			RETURN
			    IF(
			        NOT ISBLANK(OpenQty) && OpenQty > 0,
			        ROUND(DIVIDE(SumaCubierta, OpenQty), 2),
			        BLANK()
			    )
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: eb91bbe3-2325-4a71-8a45-1f867677b1a1

	measure 'Fecha Servicio 2º Quincena' = ```
			
			VAR RangoIni = MIN ( 'RangoDisponibilidad'[Fecha] )
			VAR RangoFin = MAX ( 'RangoDisponibilidad'[Fecha] )
			VAR TotalPendiente = SUM ( 'LOL_PLANMATERIAL'[Unidades pendientes Entregar] )
			VAR TotalCubierto =
			    SUMX (
			        'LOL_PLANMATERIAL',
			        VAR FechaFin = 'LOL_PLANMATERIAL'[Fecha Fin pedido venta]
			        VAR FechaDisp = 'LOL_PLANMATERIAL'[Fecha disponibilidad (línea del articulo)]
			        VAR EnAlmacen = 'LOL_PLANMATERIAL'[Uniades en Piciking] + 'LOL_PLANMATERIAL'[Unidades asignadas]
			        VAR EnTransito = 'LOL_PLANMATERIAL'[Unidades asignadas Transito]
			        RETURN
			            IF (
			                NOT ISBLANK ( FechaDisp )
			                    && FechaDisp >= RangoIni
			                    && FechaDisp <= RangoFin
			                    && NOT ISBLANK ( FechaFin )
			                    && FechaDisp > FechaFin - 4 && FechaDisp <= FechaFin + 11,
			                EnTransito,
			                0
			            )
			    )
			RETURN
			    IF ( TotalPendiente > 0, DIVIDE ( TotalCubierto, TotalPendiente ), BLANK () )
			
			```
		formatString: 0\ %;-0\ %;0\ %
		lineageTag: b0ede849-d5cf-4c2f-893f-2a4a250683f2

