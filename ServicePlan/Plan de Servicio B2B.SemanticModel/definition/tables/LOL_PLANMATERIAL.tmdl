		annotation SummarizationSetBy = Automatic

	partition LOL_PLANMATERIAL = m
		mode: import
		source = Value.NativeQuery(SapHana.Database("192.168.0.231:30015", [Implementation="2.0"]), "WITH ""PICK"" AS (#(lf)SELECT#(lf)#(tab)T1.""BaseObject"",#(lf)#(tab)T1.""OrderEntry"",#(lf)#(tab)T1.""OrderLine"",#(lf)#(tab)SUM(T1.""PrevReleas"") ""PrevReleas""#(lf)FROM#(lf)#(tab)SBO_LOLA_SUCURSAL.OPKL T0#(lf)LEFT JOIN SBO_LOLA_SUCURSAL.PKL1 T1 ON#(lf)#(tab)T0.""AbsEntry"" = T1.""AbsEntry""#(lf)WHERE#(lf)#(tab)T1.""PickStatus"" <> 'C'#(lf)GROUP BY#(lf)#(tab)T1.""BaseObject"",#(lf)#(tab)T1.""OrderEntry"",#(lf)#(tab)T1.""OrderLine""), #(lf)#(tab)#(lf)#(lf)#(lf)    -- Primer bloque: OPKL retenido (sin enviar a RMT)#(lf)""PACK_HOLD"" AS (#(lf)  SELECT #(lf)    T1.""DocEntry"",T1.""LineNum"",#(lf)    MAX(T4.""SlpName"") AS ""Representante"",#(lf)    MAX(T3.""CardCode"") AS ""CardCode"",#(lf)    SUM(#(lf)        CASE #(lf)          WHEN T5.""U_GSP_LOLENVIORMT"" = 'N' AND T5.""Status"" <> 'C' #(lf)          THEN T1.""Quantity""#(lf)          ELSE 0 #(lf)        END#(lf)    ) AS ""UnidadesRetenidas"",#(lf)    SUM(#(lf)        CASE #(lf)          WHEN T5.""U_GSP_LOLENVIORMT"" = 'N' AND T5.""Status"" <> 'C' #(lf)          THEN ROUND(#(lf)                  ROUND((T1.""PriceBefDi"" * T1.""Quantity"") - ((T1.""PriceBefDi"" * T1.""Quantity"") * T1.""DiscPrcnt"" / 100), 2)#(lf)                  - (#(lf)                      ROUND((T1.""PriceBefDi"" * T1.""Quantity"") - ((T1.""PriceBefDi"" * T1.""Quantity"") * T1.""DiscPrcnt"" / 100), 2) * T3.""DiscPrcnt"" / 100#(lf)                    ), 2)#(lf)          ELSE 0 #(lf)        END#(lf)    ) AS ""MontoRetenido"",#(lf)    'Y' AS ""P&H""#(lf)  FROM SBO_LOLA_SUCURSAL.PKL1 T0#(lf)  LEFT JOIN SBO_LOLA_SUCURSAL.RDR1 T1 ON T0.""OrderEntry"" = T1.""DocEntry"" AND T0.""OrderLine"" = T1.""LineNum"" AND T0.""BaseObject"" = '17'#(lf)  LEFT JOIN SBO_LOLA_SUCURSAL.ORDR T3 ON T1.""DocEntry"" = T3.""DocEntry""#(lf)  LEFT JOIN SBO_LOLA_SUCURSAL.OSLP T4 ON T3.""SlpCode"" = T4.""SlpCode""#(lf)  LEFT JOIN SBO_LOLA_SUCURSAL.OPKL T5 ON T0.""AbsEntry"" = T5.""