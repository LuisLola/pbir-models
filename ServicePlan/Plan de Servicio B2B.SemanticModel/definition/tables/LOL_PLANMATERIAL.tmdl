	column 'Clasificación Entrega' = ```
			
			VAR FechaEntrega = 'LOL_PLANMATERIAL'[Fecha Entrega pedido venta]
			VAR FechaDisponible = 'LOL_PLANMATERIAL'[Fecha disponibilidad (línea del articulo)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK( FechaDisponible ), BLANK(),
			        FechaDisponible <= FechaEntrega + 15, "Fecha Servicio 1º Quincena",
			        FechaDisponible <= FechaEntrega + 30, "Fecha Servicio 2º Quincena",
			        FechaDisponible > FechaEntrega + 30, "Fecha Servicio > 30 días",
			        BLANK()
			    )
			
			```
		lineageTag: 5a3a4cde-419f-4fdc-bff2-957b270a2d03
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

