	measure 'Cantidad Original por Pedido' = ```
			
			SUMX(
			    VALUES('LOL_PLANMATERIAL'[Nº Pedido Ventas]),
			    CALCULATE(SUM('LOL_PLANMATERIAL'[Cantidad Original]))
			)
			
			
			```
		lineageTag: 288c4d3e-193f-4e2e-9e68-cad9ec603d29

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cantidad Original por Pedido2' = ```
			
			SUMX(
			    SUMMARIZE(
			        'LOL_PLANMATERIAL',
			        'LOL_PLANMATERIAL'[Nº Pedido Ventas],
			        "TotalPedido", SUM('LOL_PLANMATERIAL'[Cantidad Original])
			    ),
